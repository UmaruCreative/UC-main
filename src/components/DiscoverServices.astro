---
---

<section id="services" class="py-20 md:py-32 bg-accent-50 animate-on-scroll">
  <div class="container mx-auto px-6 md:px-12">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="inline-block px-3 py-1 bg-white text-primary-800 rounded-full text-sm font-alexandria mb-4">
          Services
        </span>

        <h2 class="font-alexandria font-bold text-3xl md:text-4xl mb-4">
          Discover My Services
        </h2>

        <p class="text-lg text-primary-800">
          Web design, content, local search — and daily market intelligence.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Card 1: Web Design -->
        <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
          <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <h3 class="font-alexandria font-bold text-xl mb-4">Web Design</h3>
          <p class="text-primary-700 mb-6">
            Custom websites built for clarity — easy for your visitors to navigate, easy for you to manage, and structured so search engines and AI tools can read them accurately.
          </p>
          <a href="/en/services/web-design" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
            Learn More →
          </a>
        </div>

        <!-- Card 2: Digital Content -->
        <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
          <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
            </svg>
          </div>
          <h3 class="font-alexandria font-bold text-xl mb-4">Digital Content</h3>
          <p class="text-primary-700 mb-6">
            Short video content, social media visuals, promotional materials, and email campaigns that tell your story without noise. Made to match your site's voice.
          </p>
          <a href="/en/services/content-creation" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
            Learn More →
          </a>
        </div>

        <!-- Card 3: Google My Business -->
        <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
          <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
            </svg>
          </div>
          <h3 class="font-alexandria font-bold text-xl mb-4">Google My Business</h3>
          <p class="text-primary-700 mb-6">
            Your Google profile, set up and optimised so local searches find you first. Especially useful if your customers are nearby and looking right now.
          </p>
          <a href="/en/services/google-my-business" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
            Learn More →
          </a>
        </div>

        <!-- Card 4: Market Intelligence (NEW) -->
        <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
          <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
            </svg>
          </div>
          <h3 class="font-alexandria font-bold text-xl mb-4">Market Intelligence</h3>
          <p class="text-primary-700 mb-6">
            A daily scan of your competitors, your buyers' searches, and your visibility gaps — delivered as a structured morning report. Every claim sourced.
          </p>
          <a href="/en/contact" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
            Learn More →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
