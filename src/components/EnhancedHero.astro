---
---

<section class="min-h-screen flex flex-col justify-center relative overflow-hidden pt-16 animate-on-scroll">
  <!-- Background with clouds -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.pexels.com/photos/531756/pexels-photo-531756.jpeg?auto=compress&cs=tinysrgb&w=1920&h=1080&dpr=2"
      alt="Blue sky with floating clouds"
      class="w-full h-full object-cover opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-primary-50/80 to-white/90"></div>
  </div>

  <!-- Animated logo characters -->
  <img
    id="logo-char-1"
    src="/Dango-transparent.png"
    alt="Umaru Logo"
    class="absolute w-96 h-96 opacity-90 z-20"
    style="right: 5%; bottom: 20%;"
  />
  <img
    id="logo-char-2"
    src="/Dango-transparent.png"
    alt="Umaru Logo"
    class="absolute w-60 h-60 opacity-50 z-20"
    style="left: 18%; top: 50%;"
  />

  <div class="container mx-auto px-6 md:px-12 py-20 md:py-32 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="font-alexandria font-bold text-4xl md:text-5xl lg:text-6xl leading-tight mb-6">
        <span class="hero-line" data-delay="0">Websites built to be found —</span><br>
        <span class="hero-line" data-delay="0.5">by people, and by AI.</span>
      </h1>

      <p class="text-lg md:text-xl text-primary-800 mb-10 max-w-3xl mx-auto">
        <span class="hero-line" data-delay="1">Handcrafted for small businesses in Jyväskylä, Finland.</span><br>
        <span class="hero-line" data-delay="1.5">Clean code, honest pricing, no agency overhead.</span>
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center hero-buttons" data-delay="2">
        <a
          href="/en/pricing"
          class="px-8 py-4 bg-primary-800 text-white rounded-md font-alexandria hover:bg-primary-700 transition-all duration-300 hover:shadow-lg hover:scale-105"
        >
          View Pricing
        </a>
        <a
          href="/en/contact"
          class="px-8 py-4 bg-accent-100 text-primary-900 rounded-md font-alexandria hover:bg-accent-200 transition-all duration-300 hover:shadow-lg hover:scale-105"
        >
          Ask a Question
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-line {
    opacity: 0;
    transform: translateY(30px);
    display: inline-block;
  }

  .hero-buttons {
    opacity: 0;
    transform: translateY(30px);
  }

  @keyframes logoRun {
    0% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-50px, -30px) scale(1.1); }
    50% { transform: translate(-100px, 20px) scale(0.9); }
    75% { transform: translate(-30px, 40px) scale(1.05); }
    100% { transform: translate(0, 0) scale(1); }
  }

  #logo-char-1 {
    animation: logoRun 8s ease-in-out infinite;
    animation-delay: 0s;
  }

  #logo-char-2 {
    animation: logoRun 12s ease-in-out infinite;
    animation-delay: 4s;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Text fade in line by line
  document.addEventListener('DOMContentLoaded', () => {
    const heroLines = document.querySelectorAll('.hero-line');
    const heroButtons = document.querySelector('.hero-buttons');

    heroLines.forEach((line, index) => {
      const delay = parseFloat(line.dataset.delay) || 0;

      gsap.to(line, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        delay: delay,
        ease: "power2.out"
      });
    });

    if (heroButtons) {
      const delay = parseFloat(heroButtons.dataset.delay) || 0;
      gsap.to(heroButtons, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        delay: delay,
        ease: "power2.out"
      });
    }
  });
</script>
