---
import { useI18n } from "../../i18n";
const { t } = useI18n(Astro.url);
// Each ring is one week of visits. Busier weeks grow wider rings, like a real tree.
const weeks = [420, 380, 510, 560, 490, 640, 700, 660, 812, 860, 930, 1284];
const cx = 200;
const cy = 200;
let r = 26;
const rings = weeks.map((v, i) => {
  r += 4 + (v / 1284) * 11;
  const pts: string[] = [];
  const n = 72;
  for (let k = 0; k <= n; k++) {
    const ang = (k / n) * Math.PI * 2;
    const wobble = 1 + 0.035 * Math.sin(3 * ang + i * 0.9) + 0.02 * Math.sin(7 * ang + i * 1.7) + 0.012 * Math.cos(11 * ang + i);
    const rr = r * wobble;
    pts.push(`${(cx + rr * Math.cos(ang)).toFixed(1)},${(cy + rr * Math.sin(ang) * 0.94).toFixed(1)}`);
  }
  return { d: `M${pts.join(" L")} Z`, w: 1.2 + (v / 1284) * 2.4, o: 0.45 + (i / weeks.length) * 0.5 };
});
---

<figure class="rings">
  <svg viewBox="0 0 400 400" data-rings role="img" aria-label={t.rings.aria}>
    <circle cx={cx} cy={cy} r={r + 16} fill="#e7d3b3" />
    <circle cx={cx} cy={cy} r={r + 16} fill="none" stroke="#5a3e2b" stroke-width="10" />
    <circle cx={cx} cy={cy} r="24" fill="#c9996a" data-ring-core />
    {rings.map((ring, i) => (
      <path d={ring.d} fill="none" stroke="#6b4a31" stroke-width={ring.w} stroke-opacity={ring.o} stroke-linecap="round" data-ring />
    ))}
    <path d="M200 200 L 330 128" stroke="#5a3e2b" stroke-width="1.5" opacity="0.35" />
    <circle cx={cx} cy={cy} r="4" fill="#5a3e2b" />
  </svg>
  <figcaption>
    <p class="mono">{t.rings.week} <span data-ring-week>12</span> {t.rings.of}</p>
    <p class="rings__cap">{t.rings.caption}</p>
  </figcaption>
</figure>

<style>
  .rings { margin: 0; display: grid; gap: 18px; justify-items: center; text-align: center; }
  .rings svg { width: 100%; max-width: 380px; height: auto; display: block; filter: drop-shadow(0 30px 40px rgba(55, 38, 26, 0.25)); }
  .rings .mono { color: var(--fern); margin: 0 0 6px; }
  .rings__cap { margin: 0; max-width: 30ch; color: var(--ink-soft); font-size: 15px; }
</style>
