---
import { useI18n } from "../../i18n";
const { t } = useI18n(Astro.url);
// A rope ladder that tracks how far down the tree you are.
// Rungs are built at runtime from every [data-floor] section on the page.
---

<aside class="rail" data-rail aria-label={t.common.sections} data-goto={t.common.goTo}>
  <div class="rail__alt mono" aria-hidden="true"><span data-rail-alt>18.0</span> m</div>
  <div class="rail__rope" aria-hidden="true">
    <span class="rail__rope-l"></span><span class="rail__rope-r"></span>
  </div>
  <ol class="rail__rungs" data-rail-rungs></ol>
  <div class="rail__lantern" data-rail-lantern aria-hidden="true">
    <svg viewBox="0 0 24 34" width="18" height="26">
      <path d="M12 0v5" stroke="currentColor" stroke-width="1.4" />
      <rect x="5" y="5" width="14" height="4" rx="1.5" fill="currentColor" />
      <path d="M6 9h12l-1.5 17h-9z" fill="#f3a738" />
      <rect x="4" y="26" width="16" height="4" rx="1.5" fill="currentColor" />
    </svg>
    <span class="rail__glow"></span>
  </div>
  <p class="rail__label mono" data-rail-label aria-live="polite"></p>
</aside>

<style>
  .rail {
    position: fixed;
    right: 22px;
    top: 50%;
    z-index: 90;
    height: min(62vh, 520px);
    width: 30px;
    transform: translateY(-50%);
    color: var(--ink);
    transition: color 0.5s, opacity 0.5s;
    display: none;
  }
  @media (min-width: 1320px) { .rail { display: block; } }
  .rail.is-night { color: var(--night-ink); }
  .rail.is-hidden { opacity: 0; pointer-events: none; }

  .rail__alt {
    position: absolute;
    top: -34px;
    right: 0;
    white-space: nowrap;
    font-size: 11px;
    opacity: 0.7;
  }
  .rail__rope { position: absolute; inset: 0; }
  .rail__rope span {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: repeating-linear-gradient(to bottom, currentColor 0 5px, transparent 5px 7px);
    opacity: 0.35;
  }
  .rail__rope-l { left: 6px; }
  .rail__rope-r { right: 6px; }

  .rail__rungs { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; }
  .rail__rungs :global(li) { position: absolute; left: 0; right: 0; height: 14px; transform: translateY(-50%); }
  .rail__rungs :global(button) {
    position: absolute;
    inset: 0;
    width: 100%;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }
  .rail__rungs :global(button)::before {
    content: "";
    position: absolute;
    left: 5px;
    right: 5px;
    top: 50%;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.35;
    transition: opacity 0.4s, background 0.4s, transform 0.4s var(--ease-out);
  }
  .rail__rungs :global(button:hover)::before { opacity: 0.8; transform: scaleX(1.25); }
  .rail__rungs :global(li.is-active button)::before { background: var(--lantern); opacity: 1; }
  .rail__rungs :global(.rail__tip) {
    position: absolute;
    right: 40px;
    top: 50%;
    transform: translate(8px, -50%);
    white-space: nowrap;
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--birch);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s, transform 0.4s var(--ease-out);
  }
  .rail__rungs :global(button:hover + .rail__tip),
  .rail__rungs :global(button:focus-visible + .rail__tip) { opacity: 1; transform: translate(0, -50%); }

  .rail__lantern {
    position: absolute;
    left: 50%;
    top: 0;
    width: 18px;
    margin-left: -9px;
    transform: translateY(-50%);
    color: var(--bark-dark);
    will-change: transform;
  }
  .rail.is-night .rail__lantern { color: var(--night-ink); }
  .rail__lantern svg { position: relative; z-index: 1; display: block; }
  .rail__glow {
    position: absolute;
    left: 50%;
    top: 55%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(243, 167, 56, 0.55), rgba(243, 167, 56, 0) 65%);
    animation: flicker 3.2s infinite ease-in-out;
  }
  @keyframes flicker {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    40% { opacity: 1; transform: scale(1.08); }
    60% { opacity: 0.7; transform: scale(0.96); }
  }

  .rail__label {
    position: absolute;
    right: 8px;
    top: calc(100% + 18px);
    writing-mode: vertical-rl;
    margin: 0;
    white-space: nowrap;
    font-size: 11px;
    opacity: 0.75;
  }
</style>
