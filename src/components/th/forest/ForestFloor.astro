---
// The forest floor at the foot of the treehouse pine: the little theatre at the
// end of the climb. Night, lit by a campfire. Three Dangos:
//   the coffee friend by the fire (two kuksa cups on the stump: one is for the guide),
//   the mushroom picker up on the conk with today's chanterelles,
//   and the guide, who rides a leaf down the page and lands here.
// Finding every hidden Dango on the way down turns on the northern lights.
import "../../../styles/forest.css";
import { SEASON } from "../../../season";
import Dango from "./Dango.astro";
import Conk from "./Conk.astro";
import Kantarelli from "./Kantarelli.astro";
import Yellowfoot from "./Yellowfoot.astro";
import { conkTop } from "./geo";

const winter = SEASON === "winter";
const upper = { x: 692, y: 290, w: 262, dir: -1 as const };
const lower = { x: 848, y: 410, w: 190, dir: 1 as const };
const on = (c: typeof upper | typeof lower, x: number) => Math.round((c.y + conkTop(c.w, Math.abs(x - c.x) / c.w)) * 10) / 10;

// Seeded scatter for stars, moss speckles and fireflies
let seed = 11;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 70 }, () => ({ x: rand() * 1440, y: rand() * 300, r: rand() * 1.3 + 0.3, o: 0.3 + rand() * 0.6 }));
const speck = Array.from({ length: 220 }, () => { const x = rand() * 1440; return { x, y: 556 + rand() * 64, r: rand() * 2.6 + 0.5, warm: Math.abs(x - 560) < 280 }; });
const flies = Array.from({ length: 22 }, (_, i) => ({ x: 120 + rand() * 1200, y: 250 + rand() * 280, d: -(rand() * 6).toFixed(2), i }));
const pine = (x: number, base: number, h: number) => `M${x} ${base - h} L ${x + h * 0.13} ${base - h * 0.55} L ${x + h * 0.07} ${base - h * 0.56} L ${x + h * 0.2} ${base} L ${x - h * 0.2} ${base} L ${x - h * 0.07} ${base - h * 0.56} L ${x - h * 0.13} ${base - h * 0.55} Z`;
const farPines = Array.from({ length: 34 }, (_, i) => ({ x: i * 44 + rand() * 30, h: 110 + rand() * 90 }));
const nearPines = Array.from({ length: 16 }, (_, i) => ({ x: i * 96 + rand() * 40, h: 170 + rand() * 120 })).filter((p) => p.x < 560 || p.x > 960);
const lichen = [[190, 592], [1085, 586], [870, 604], [300, 610], [1240, 598]].map(([x, y]) => Array.from({ length: 9 }, () => ({ x: x + (rand() - 0.5) * 46, y: y + (rand() - 0.5) * 12, r: 6 + rand() * 6 })));
const fallen = [[430, 584, "#e8963a"], [736, 590, "#f2c14e"], [990, 596, "#c2452d"], [262, 600, "#f2c14e"], [1150, 590, "#e8963a"], [560, 260, "#e8963a"], [930, 396, "#f2c14e"]] as const;
const bark = Array.from({ length: 16 }, () => ({ x: 708 + rand() * 120, y: rand() * 520, w: 14 + rand() * 18 }));
// Where the found Dangos sit when the northern lights come on
const watchers = [
  { x: 470, y: on(upper, 470), h: 64 },
  { x: 900, y: on(lower, 900), h: 62 },
  { x: 945, y: on(lower, 945), h: 58 },
  { x: 990, y: on(lower, 990), h: 54 },
];
---

<div class="stage" data-stage aria-hidden="true">
  <svg viewBox="0 0 1440 620" preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id="st-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--night)" /><stop offset=".55" stop-color="#16292a" /><stop offset="1" stop-color="#2a4440" />
      </linearGradient>
      <linearGradient id="st-bark" x1="0" x2="1"><stop offset="0" stop-color="#5a3c2a" /><stop offset=".45" stop-color="#3f2a1d" /><stop offset="1" stop-color="#22160f" /></linearGradient>
      <linearGradient id="st-moss" x1="0" x2="1"><stop offset="0" stop-color="#3f5a35" /><stop offset=".38" stop-color="#6f7a36" /><stop offset=".6" stop-color="#3f5a35" /><stop offset="1" stop-color="#1a2b2a" /></linearGradient>
      <linearGradient id="st-aurora" x1="0" x2="1"><stop offset="0" stop-color="#5ff2c4" stop-opacity="0" /><stop offset=".3" stop-color="#5ff2c4" stop-opacity=".55" /><stop offset=".7" stop-color="#7fd8ff" stop-opacity=".45" /><stop offset="1" stop-color="#b98cff" stop-opacity="0" /></linearGradient>
      <linearGradient id="st-fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color: var(--night)" stop-opacity="1" /><stop offset="1" style="stop-color: var(--night)" stop-opacity="0" /></linearGradient>
      <linearGradient id="st-trunk-fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000" /><stop offset=".28" stop-color="#fff" /></linearGradient>
      <mask id="st-trunk-mask" maskUnits="userSpaceOnUse" x="0" y="-20" width="1440" height="640"><rect x="0" y="-20" width="1440" height="640" fill="url(#st-trunk-fade)" /></mask>
      <filter id="st-soft" x="-10%" y="-60%" width="120%" height="220%"><feGaussianBlur stdDeviation="10" /></filter>
      <radialGradient id="st-fire" r=".5"><stop offset="0" stop-color="#ffb04a" stop-opacity=".55" /><stop offset=".5" stop-color="#ff8a3a" stop-opacity=".16" /><stop offset="1" stop-color="#ff8a3a" stop-opacity="0" /></radialGradient>
      <linearGradient id="st-kuksa" x1="0" x2="1"><stop offset="0" stop-color="#c08850" /><stop offset="1" stop-color="#7a4f2a" /></linearGradient>
    </defs>

    <!-- night sky, moon and the far shore -->
    <rect width="1440" height="620" fill="url(#st-sky)" />
    <rect width="1440" height="140" fill="url(#st-fade)" />
    {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#fff" opacity={s.o} />)}
    <path d="M300 190 a38 38 0 1 0 34 58 a31 31 0 1 1 -34 -58 Z" fill="#fff4cf" />
    <g class="stage__aurora" fill="none" stroke="url(#st-aurora)" stroke-linecap="round" filter="url(#st-soft)">
      <path d="M80 120 C 380 40, 700 170, 1020 70 S 1320 90, 1430 50" stroke-width="44" />
      <path d="M180 170 C 460 100, 760 210, 1080 120 S 1300 140, 1400 110" stroke-width="22" opacity=".7" />
    </g>
    <g fill="#1e3532">{farPines.map((p) => <path d={pine(p.x, 410, p.h)} />)}</g>
    <rect x="0" y="398" width="1440" height="70" fill="#223a66" />
    <g stroke="#fff4cf" stroke-width="2" stroke-linecap="round" opacity=".55" class="stage__glint">
      <line x1="280" y1="414" x2="330" y2="414" /><line x1="292" y1="428" x2="322" y2="428" /><line x1="270" y1="442" x2="300" y2="442" /><line x1="306" y1="452" x2="340" y2="452" />
    </g>
    <g fill="#10201e">{nearPines.map((p) => <path d={pine(p.x, 486, p.h)} />)}</g>

    <!-- campfire light on everything near it -->
    <circle class="stage__glow" cx="540" cy="540" r="330" fill="url(#st-fire)" />

    <!-- the old treehouse pine -->
    <g filter="url(#fx-grain)" mask="url(#st-trunk-mask)">
      <path d="M690 -10 L 852 -10 C 850 200, 858 430, 912 566 L 636 566 C 684 430, 692 200, 690 -10 Z" fill="url(#st-bark)" stroke="#170e08" stroke-width="1.5" stroke-opacity=".6" />
      {bark.map((b) => <path d={`M${b.x} ${b.y} q ${b.w * 0.4} 6 ${b.w} 2`} stroke="#140c07" stroke-width="2" fill="none" opacity=".45" />)}
      <path d="M760 20 C 754 200, 770 420, 760 566" stroke="#140c07" stroke-width="2" fill="none" opacity=".3" />
      <path d="M700 40 C 704 220, 702 420, 664 560" stroke="#c98a52" stroke-width="3" fill="none" opacity=".35" />
    </g>

    <!-- ground -->
    <g filter="url(#fx-grain)">
      <path d="M0 566 C 220 548, 420 562, 640 556 S 1060 544, 1440 562 L1440 620 L0 620 Z" fill={winter ? "#e8eff4" : "url(#st-moss)"} />
      {!winter && speck.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill={s.warm ? "#b8a84c" : "#3c5a42"} opacity=".5" />)}
      {lichen.map((g) => g.map((c) => <circle cx={c.x} cy={c.y} r={c.r} fill={winter ? "#ffffff" : "#c9cfb6"} opacity=".85" />))}
    </g>

    <!-- conks on the pine -->
    <g filter="url(#fx-grain)">
      <Conk {...upper} />
      <Conk {...lower} />
    </g>

    <!-- lantern hanging under the lower conk -->
    <g class="stage__lantern" transform="translate(968 446)">
      <circle cx="0" cy="34" r="70" fill="url(#fx-warm)" />
      <line x1="0" y1="0" x2="0" y2="16" stroke="#2b1c12" stroke-width="2" />
      <rect x="-9" y="16" width="18" height="5" rx="2" fill="#2b1c12" />
      <path d="M-8 21 H8 L6 46 H-6 Z" fill="#ffd27a" />
      <rect x="-11" y="46" width="22" height="6" rx="2" fill="#2b1c12" />
    </g>

    <!-- mushrooms -->
    <g filter="url(#fx-grain)">
      <Kantarelli x={392} y={572} s={0.36} flip lean={-1.2} seed={2} light={1} />
      <Kantarelli x={418} y={576} s={0.48} lean={0.6} seed={1} light={1} />
      <Kantarelli x={440} y={574} s={0.3} lean={1.5} seed={4} light={1} />
      <Kantarelli x={1040} y={570} s={0.42} lean={1} seed={0} light={-1} />
      <Kantarelli x={1066} y={574} s={0.3} flip lean={-1} seed={3} light={-1} />
      <Yellowfoot x={300} y={582} s={0.5} tilt={-8} seed={1} />
      <Yellowfoot x={314} y={586} s={0.58} tilt={4} seed={2} />
      <Yellowfoot x={328} y={580} s={0.46} tilt={12} seed={3} />
      <Yellowfoot x={1180} y={578} s={0.44} tilt={-4} seed={4} />
      <Yellowfoot x={1194} y={582} s={0.5} tilt={8} seed={5} />
    </g>
    {fallen.map(([x, y, c]) => <ellipse cx={x} cy={y} rx="10" ry="4.2" fill={c} transform={`rotate(${(x * 7) % 70 - 35} ${x} ${y})`} opacity=".92" />)}

    <!-- the campfire -->
    <g class="stage__fire" transform="translate(520 572)">
      {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <ellipse cx={Math.cos((Math.PI * i) / 7) * 38} cy={6 - Math.sin((Math.PI * i) / 7) * 4 + (i % 2) * 2} rx="10" ry="6.5" fill="#6f7179" />)}
      <rect x="-32" y="-4" width="64" height="10" rx="5" fill="#5a3a26" transform="rotate(18)" />
      <rect x="-32" y="-4" width="64" height="10" rx="5" fill="#6b4a31" transform="rotate(-18)" />
      <g class="stage__flames">
        <path d="M-18 0 C -25 -28, -6 -36, -4 -60 C 6 -38, 23 -32, 17 0 Z" fill="#f06a2a" />
        <path d="M-10 0 C -12 -19, 0 -25, 2 -43 C 8 -26, 16 -19, 10 0 Z" fill="#ffb23f" />
        <path d="M-4 0 C -5 -11, 1 -15, 2 -24 C 5 -13, 7 -9, 5 0 Z" fill="#fff0b0" />
      </g>
      <g class="stage__sparks" fill="#ffd27a">
        <circle cx="-4" cy="-60" r="1.6" /><circle cx="6" cy="-70" r="1.2" /><circle cx="0" cy="-80" r="1" />
      </g>
    </g>

    <!-- the stump with two kuksa cups: one is waiting for the guide -->
    <g transform="translate(684 566)">
      <g filter="url(#fx-grain)">
        <path d="M-48 0 L -42 -52 L 42 -52 L 48 0 Z" fill="#5a3c2a" stroke="#170e08" stroke-width="1.5" stroke-opacity=".6" />
        <path d="M-48 0 L -42 -52 L -20 -52 L -26 0 Z" fill="#c98a52" opacity=".22" />
        <ellipse cx="0" cy="-52" rx="42" ry="10" fill="#c9996a" stroke="#170e08" stroke-width="1.5" stroke-opacity=".6" />
        <ellipse cx="0" cy="-52" rx="26" ry="6" fill="none" stroke="#a87a4c" stroke-width="1.5" />
        <ellipse cx="0" cy="-52" rx="12" ry="3" fill="none" stroke="#a87a4c" stroke-width="1.2" />
      </g>
      {[[-16, -58], [17, -56]].map(([ux, uy], i) => (
        <g>
          <path d={`M${ux - 10} ${uy - 14} h20 l-2 14 q-8 4 -16 0 Z`} fill="url(#st-kuksa)" stroke="#3a2214" stroke-width="1.3" />
          <ellipse cx={ux} cy={uy - 14} rx="10" ry="2.6" fill="#3d2414" />
          <path d={`M${ux + 10} ${uy - 11} q 7 1 4 7 q -2 3 -5 2`} stroke="#7a4f2a" stroke-width="2.4" fill="none" />
          <path class="stage__steam" style={`--i:${i}`} d={`M${ux - 2} ${uy - 20} q -5 -8 1 -14 q 5 -6 0 -12 q -4 -6 1 -11`} stroke="#e9eef5" stroke-width="1.8" fill="none" opacity=".6" />
        </g>
      ))}
    </g>

    <!-- the cast -->
    <Dango x={600} y={566} h={96} anim="sip" light="fire-left" glow="night" id="sd-coffee" cls="stage__coffee" />
    <g class="stage__picker">
      <Dango x={590} y={on(upper, 590)} h={88} anim="bounce" delay={-0.8} light="fire-left" glow="night" id="sd-picker" />
      <!-- today's chanterelles, in a sienikori basket beside him -->
      <g transform={`translate(526 ${on(upper, 526)})`}>
        <g class="stage__roll"><Kantarelli x={-22} y={-2} s={0.11} lean={1} seed={5} /></g>
        <Kantarelli x={-6} y={-19} s={0.13} lean={1} seed={1} />
        <Kantarelli x={6} y={-20} s={0.12} flip lean={-1} seed={3} />
        <path d="M-20 -22 L 20 -22 L 16 0 L -16 0 Z" fill="#b07a45" stroke="#5a3a20" stroke-width="1.5" />
        <path d="M-19 -15 H19 M-18 -9 H18 M-17 -3 H17" stroke="#7a5232" stroke-width="1.2" />
        <path d="M-18 -22 C -18 -48, 18 -48, 18 -22" stroke="#7a5232" stroke-width="3" fill="none" />
      </g>
    </g>
    <g class="stage__guide" data-guide-land>
      <ellipse class="stage__leaf" cx="780" cy="570" rx="30" ry="6" fill="#e8963a" transform="rotate(-6 780 570)" />
      <Dango x={772} y={568} h={90} anim="sway" light="fire-left" glow="night" id="sd-guide" />
    </g>

    <!-- the crew you found on the way down: they come to watch the northern lights -->
    <g class="stage__watchers">
      {watchers.map((w, i) => <g style={`--i:${i}`} class="stage__watcher"><Dango x={w.x} y={w.y} h={w.h} anim="bounce" delay={-i * 0.7} light="fire-left" glow="night" id={`sd-watch-${i}`} /></g>)}
    </g>

    <!-- fireflies -->
    <g class="stage__flies">
      {flies.map((f) => <g style={`--d:${f.d}s`}><circle cx={f.x} cy={f.y} r="5" fill="#ffe08a" opacity=".18" /><circle cx={f.x} cy={f.y} r="1.6" fill="#fff3c4" /></g>)}
    </g>
  </svg>
  <canvas class="season-fx" data-season-fx={SEASON} data-density="0.55" aria-hidden="true"></canvas>
</div>

<script>
  import { initSeason } from "../../../scripts/season";
  initSeason();
</script>

<style>
  .stage {
    position: relative;
    /* follows the drawing's own proportions, so the sky and the moon are never cut off */
    aspect-ratio: 1440 / 620;
    min-height: 420px;
    max-height: 860px;
    width: 100%;
    background: var(--night);
  }
  .stage svg { display: block; width: 100%; height: 100%; }

  .stage__aurora { opacity: 0; transition: opacity 3s ease; }
  :global(.stage.is-aurora) .stage__aurora { opacity: 1; }
  .stage__watchers :global(.stage__watcher) { opacity: 0; transform: translateY(10px); transition: opacity 0.8s ease, transform 0.8s ease; transition-delay: calc(var(--i) * 0.25s + 0.6s); }
  :global(.stage.is-aurora) .stage__watchers :global(.stage__watcher) { opacity: 1; transform: none; }

  /* While the guide is still on his way down, his spot by the stump is empty */
  :global(.stage.await-guide) .stage__guide { opacity: 0; }
  :global(.stage.is-landed) .stage__guide { opacity: 1; }

  :global(html.motion) .stage__flames { transform-origin: 0 0; animation: st-flame 0.9s ease-in-out infinite alternate; }
  @keyframes st-flame { from { transform: scale(1, 1); } to { transform: scale(1.06, 0.92); } }
  :global(html.motion) .stage__glow { animation: st-glow 2.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes st-glow { 0%, 100% { opacity: 0.9; } 40% { opacity: 1; } 60% { opacity: 0.78; } }
  :global(html.motion) .stage__sparks circle { animation: st-spark 2.4s linear infinite; }
  :global(html.motion) .stage__sparks circle:nth-child(2) { animation-delay: -0.8s; }
  :global(html.motion) .stage__sparks circle:nth-child(3) { animation-delay: -1.6s; }
  @keyframes st-spark { from { transform: translate(0, 0); opacity: 1; } to { transform: translate(8px, -40px); opacity: 0; } }
  :global(html.motion) .stage__steam { stroke-dasharray: 10 8; animation: st-steam 2.6s linear infinite; animation-delay: calc(var(--i) * -1.3s); }
  @keyframes st-steam { to { stroke-dashoffset: -36; } }
  :global(html.motion) .stage__lantern { transform-box: fill-box; transform-origin: 50% 0; animation: st-sway 5s ease-in-out infinite; }
  @keyframes st-sway { 0%, 100% { transform: translate(968px, 446px) rotate(-3deg); } 50% { transform: translate(968px, 446px) rotate(3deg); } }
  :global(html.motion) .stage__flies g { animation: st-fly 6s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes st-fly { 0%, 100% { transform: translate(0, 0); opacity: 0.4; } 50% { transform: translate(12px, -16px); opacity: 1; } }
  :global(html.motion) .stage__glint { animation: st-glint 4s ease-in-out infinite; }
  @keyframes st-glint { 50% { opacity: 0.2; } }
  /* Now and then a chanterelle tumbles out of the basket */
  :global(html.motion) .stage__roll { animation: st-roll 9s ease-in infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes st-roll {
    0%, 60% { transform: translate(0, 0) rotate(0); opacity: 1; }
    72% { transform: translate(-30px, 2px) rotate(-200deg); opacity: 1; }
    80% { transform: translate(-42px, 4px) rotate(-260deg); opacity: 0; }
    100% { transform: translate(0, 0) rotate(0); opacity: 0; }
  }
</style>
