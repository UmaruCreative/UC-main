---
// A Dango hiding on one of the floors, peeking out beside a little prop that
// belongs to that floor. Poke him to "find" him. Find every one on the way
// down and the northern lights come on over the campfire at the bottom.
// The props sit beside him; nothing is put on the Dango himself.
import { DANGO } from "../../../season";

interface Props {
  id: string;
  prop: "paint" | "telescope" | "blueprint" | "book";
  side?: "left" | "right";
}
const { id, prop, side = "right" } = Astro.props;
const H = 52;
const W = Math.round(H * DANGO.ratio * 10) / 10;
const img = `<image class="dango__art" href="${DANGO.src}" x="${-W / 2}" y="${-H}" width="${W}" height="${H}" />`;
---

<span class={`hidden-dango hidden-dango--${side}`} data-hidden-dango={id} aria-hidden="true">
  <svg viewBox="-60 -66 120 76" width="120" height="76">
    <g class="hidden-dango__who" data-dango>
      <g class="dango__boing">
        <g class="hidden-dango__peek">
          <ellipse cx="0" cy="1" rx="11" ry="2.2" fill="rgba(12,18,30,.25)" />
          <Fragment set:html={img} />
        </g>
        <g class="dango__sparks">
          <path d="M0 -70 l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3z" />
          <path d="M-20 -54 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" />
          <path d="M20 -58 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" />
        </g>
      </g>
    </g>
    {
      prop === "paint" && (
        <g transform="translate(30 0)">
          <path d="M-13 -24 h26 l-3 24 h-20 Z" fill="#8a96a8" stroke="#2c3a52" stroke-width="1.4" />
          <path d="M-13 -24 h26 v5 h-26 Z" fill="var(--lantern)" />
          <path d="M-6 -19 v7 a2 2 0 0 0 4 0 v-7" fill="var(--lantern)" />
          <path d="M-13 -24 C -13 -36, 13 -36, 13 -24" stroke="#2c3a52" stroke-width="1.6" fill="none" />
          <rect x="4" y="-46" width="5" height="22" rx="2" fill="#c9996a" transform="rotate(14 6 -35)" />
          <rect x="3" y="-30" width="7" height="8" rx="1" fill="#2c3a52" transform="rotate(14 6 -35)" />
        </g>
      )
    }
    {
      prop === "telescope" && (
        <g transform="translate(-32 0)" stroke="#2c3a52" stroke-width="1.4">
          <path d="M0 -26 L -10 0 M0 -26 L 10 0 M0 -26 L 2 0" fill="none" stroke-width="2" />
          <g transform="rotate(-28 0 -26)">
            <rect x="-18" y="-31" width="30" height="10" rx="2" fill="#c9a24f" />
            <rect x="12" y="-33" width="9" height="14" rx="2" fill="#a8843a" />
            <rect x="-23" y="-29" width="6" height="6" rx="1" fill="#2c3a52" />
          </g>
        </g>
      )
    }
    {
      prop === "blueprint" && (
        <g transform="translate(32 0)">
          <path d="M-26 0 L -20 -10 L 24 -10 L 18 0 Z" fill="#2f6bd8" stroke="#1d3f86" stroke-width="1.2" />
          <path d="M-14 -5 h18 M-10 -7 v5 M8 -5 h8" stroke="#e8f2ff" stroke-width="1" />
          <rect x="-28" y="-26" width="9" height="26" rx="4.5" fill="#3a78e0" stroke="#1d3f86" stroke-width="1.2" transform="rotate(-62 -24 -13)" />
          <rect x="-6" y="-16" width="3" height="16" rx="1" fill="#e2b04a" transform="rotate(30 -4 -8)" />
        </g>
      )
    }
    {
      prop === "book" && (
        <g transform="translate(-32 0)">
          <path d="M-22 0 L -20 -12 Q -10 -16 0 -11 Q 10 -16 20 -12 L 22 0 Q 10 -4 0 0 Q -10 -4 -22 0 Z" fill="#f8f4ea" stroke="#2c3a52" stroke-width="1.3" />
          <path d="M0 -11 V0" stroke="#2c3a52" stroke-width="1.1" />
          <path d="M-16 -8 h11 M-16 -5 h10 M5 -8 h11 M5 -5 h9" stroke="#9aa6b8" stroke-width=".9" />
          <path d="M-22 0 Q -10 -4 0 0 Q 10 -4 22 0 L 22 2 Q 10 -2 0 2 Q -10 -2 -22 2 Z" fill="var(--lantern)" />
        </g>
      )
    }
  </svg>
</span>
