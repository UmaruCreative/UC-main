---
// One Dango inside an SVG scene: your original artwork, unchanged.
// What makes him belong in the scene is around him: a contact shadow, the light
// that passes through his glass body onto the ground, firelight on the side
// facing the fire, and a soft glow of his own after dark.
// x, y: where the skewer touches the ground. h: height in scene units.
import { DANGO } from "../../../season";

interface Props {
  x: number;
  y: number;
  h?: number;
  flip?: boolean;
  anim?: "bounce" | "sway" | "hop" | "climb" | "peek" | "sleep" | "sip" | "none";
  delay?: number;
  speed?: number;
  /** where the light comes from: "sun" (upper right, daytime), "fire-left", "fire-right", or "none" */
  light?: "sun" | "fire-left" | "fire-right" | "none";
  /** glow of his own: "dusk" grows as the hero turns to dusk, "night" always on */
  glow?: "dusk" | "night" | "none";
  id?: string;
  cls?: string;
  extra?: Record<string, string>;
}

const { x, y, h = 60, flip = false, anim = "bounce", delay = 0, speed = 1, light = "sun", glow = "none", id, cls = "", extra = {} } = Astro.props;
const w = Math.round(h * DANGO.ratio * 10) / 10;
const style = `--d:${delay}s; --s:${speed};`;
const uid = id ?? `d${Math.round(x * 3 + y * 7 + h)}`;
const box = `x="${-w / 2}" y="${-h}" width="${w}" height="${h}"`;
const fire = light === "fire-left" || light === "fire-right";
// Firelight warms the side that faces the fire; the far side cools a little
const fireGrad = light === "fire-left" ? "fx-fire-l" : "fx-fire-l";
const coolGrad = "fx-cool-r";
const mirrorFire = (light === "fire-right") !== flip ? `transform="scale(-1 1)"` : "";
// Written as a string: Astro would otherwise turn SVG <image> into an HTML <img>
const art = [
  glow !== "none" ? `<image class="dango__halo dango__halo--${glow}" href="${DANGO.src}" ${box} filter="url(#fx-halo)" />` : "",
  fire ? `<mask id="m-${uid}" maskUnits="userSpaceOnUse" x="${-w}" y="${-h * 1.1}" width="${w * 2}" height="${h * 1.2}"><image href="${DANGO.src}" ${box} filter="url(#fx-whiten)" /></mask>` : "",
  `<image class="dango__art" href="${DANGO.src}" ${box} />`,
  fire ? `<g mask="url(#m-${uid})"><g ${mirrorFire}><rect ${box} fill="url(#${fireGrad})" style="mix-blend-mode:screen" /><rect ${box} fill="url(#${coolGrad})" style="mix-blend-mode:multiply" /></g></g>` : "",
].join("");
// The light through the glass lands on the side away from the light source
const causticX = light === "sun" ? -w * 0.9 : light === "fire-left" ? w * 1.3 : light === "fire-right" ? -w * 1.3 : 0;
---

<g class={`dango ${cls}`} data-dango id={id} transform={`translate(${x} ${y}) scale(${flip ? -1 : 1} 1)`} {...extra}>
  <g class="dango__boing">
    <g class={`dango__anim dango__anim--${anim}`} style={style}>
      {light !== "none" && <ellipse class="dango__caustic" cx={flip ? -causticX : causticX} cy="1" rx={w * 1.25} ry={h * 0.06} fill="url(#fx-caustic)" />}
      <ellipse class="dango__shadow" cx="0" cy="1" rx={w * 0.5} ry={h * 0.035} />
      <Fragment set:html={art} />
    </g>
    <g class="dango__sparks" aria-hidden="true">
      <path d={`M0 ${-h - 18} l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3z`} />
      <path d={`M${-w * 0.9} ${-h - 2} l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z`} />
      <path d={`M${w * 0.9} ${-h - 6} l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z`} />
    </g>
  </g>
</g>
