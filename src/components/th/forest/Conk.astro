---
// A red-belted conk (kantokääpä) growing out of a pine trunk; Dangos can stand on it.
// x, y: where it meets the bark. dir: 1 grows right, -1 grows left.
import { conk } from "./geo";
import { SEASON } from "../../../season";

interface Props { x: number; y: number; w: number; dir?: 1 | -1 }
const { x, y, w, dir = 1 } = Astro.props;
const c = conk(w);
const t = w * 0.2;
const snow = SEASON === "winter";
---

<g transform={`translate(${x} ${y}) scale(${dir} 1)`}>
  <path d={c.under} fill="#efe4cb" stroke="#3a2214" stroke-width="1.3" stroke-opacity=".6" />
  <path d={c.top} fill="url(#c-top)" stroke="#3a2214" stroke-width="1.6" stroke-opacity=".75" />
  {c.bands.map((d) => <path d={d} stroke="#2a1a10" stroke-width="1.2" fill="none" opacity=".33" />)}
  <path d={c.shine} stroke="#fff3d8" stroke-width={Math.max(2, w * 0.012)} fill="none" opacity=".35" stroke-linecap="round" />
  {snow && <path d={`M${w * 0.05} ${-t * 0.45} C ${w * 0.3} ${-t * 1.45}, ${w * 0.75} ${-t * 1.35}, ${w * 0.95} ${-t * 0.3} C ${w * 0.8} ${-t * 0.6}, ${w * 0.4} ${-t * 0.75}, ${w * 0.05} ${-t * 0.2} Z`} fill="#f7fbff" />}
</g>
