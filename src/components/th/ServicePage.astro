---
import TreehouseLayout from "../../layouts/TreehouseLayout.astro";
import PageHero from "./PageHero.astro";
import CtaBand from "./CtaBand.astro";
import { useI18n } from "../../i18n";

interface Props {
  kind: "web" | "content" | "gbp";
  slug: string;
  service: string;
}
const { kind, slug, service } = Astro.props;
const { t, l, abs } = useI18n(Astro.url);
const p = t[kind];
const meta = t.meta[kind];
const sp = t.servicePage;
---

<TreehouseLayout title={meta.title} description={meta.description} canonical={abs(`/services/${slug}/`)}>
  <PageHero
    eyebrow={p.room}
    title={p.heroTitle}
    lede={p.heroLede}
    crumbs={[{ label: t.common.home, href: l("/") }, { label: sp.services, href: l("/#rooms") }, { label: t.nav[kind].label }]}
    primary={{ label: t.common.startProject, href: l(`/contact/?service=${service}`) }}
    secondary={{ label: t.common.seePricing, href: "#prices" }}
  />

  <section class="section section--birch">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">{sp.whatYouGet}</p>
          <h2 class="h2" data-split set:html={p.featuresTitle} />
        </div>
        <p class="lede" data-reveal>{p.featuresLede}</p>
      </div>
      <ul class="features" data-stagger>
        {p.features.map((f, i) => (
          <li class="card feature">
            <span class="mono feature__no">0{i + 1}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <ul>{f.items.map((it) => <li>{it}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--night" data-night>
    <div class="wrap split">
      <div>
        <p class="eyebrow">{sp.builtOnLand}</p>
        <h2 class="h2" data-split set:html={p.whyTitle} />
        <p class="lede" data-reveal>{p.whyLede}</p>
      </div>
      <ul class="ticks" data-stagger>
        {p.why.map((w) => <li><span>{w}</span></li>)}
      </ul>
    </div>
  </section>

  <section id="prices" class="section section--sage">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">{sp.pricing}</p>
          <h2 class="h2" data-split set:html={sp.clearPrices} />
        </div>
        <p class="lede" data-reveal>{p.priceNote || sp.priceNote}</p>
      </div>
      <ul class="features" data-stagger>
        {p.prices.map((pr) => (
          <li class="card feature">
            <span class="mono feature__no">{pr.name}</span>
            <h3>{pr.price}</h3>
            <p>{pr.detail}</p>
          </li>
        ))}
      </ul>
      <p style="margin-top: 32px;" data-reveal><a class="link-arrow" href={l("/pricing/")} style="color: var(--moss);">{sp.seeAll}</a></p>
    </div>
  </section>

  <CtaBand primary={{ label: t.common.startProject, href: l(`/contact/?service=${service}`) }} />
</TreehouseLayout>
