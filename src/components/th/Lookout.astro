---
import SampleReport from "./SampleReport.astro";
import TreeRings from "./TreeRings.astro";
import { useI18n } from "../../i18n";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const { t, l } = useI18n(Astro.url);
const reports = t.lookout.reports;
---

<section id="lookout" class="section lookout" data-floor={t.lookout.floor} aria-labelledby="lookout-title">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">{t.lookout.eyebrow} <span class="chip chip--new">{t.common.newBadge}</span></p>
        <h2 id="lookout-title" class="h2" data-split set:html={t.lookout.title} />
      </div>
      <p class="lede" data-reveal>{t.lookout.lede}</p>
    </div>

    <div class="lookout__reports" data-stagger>
      {reports.map((r) => (
        <article class="card lookout__card">
          <p class="mono lookout__kicker">{r.kicker}</p>
          <h3 class="h3">{r.title}</h3>
          <p>{r.body}</p>
          <ul>
            {r.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="lookout__stage">
      <div class="lookout__report" data-reveal>
        <SampleReport />
      </div>
      <div class="lookout__rings" data-reveal data-delay="0.15">
        <TreeRings />
      </div>
    </div>

    {!compact && (
      <div class="lookout__cta" data-reveal>
        <p>{t.lookout.suited}</p>
        <div class="lookout__btns">
          <a href={l("/services/weekly-reports/")} class="btn" data-magnetic>{t.lookout.explore} <span class="btn-arrow">→</span></a>
          <a href={l("/contact/?service=reports")} class="btn btn--ghost" data-magnetic>{t.lookout.sample}</a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .lookout { background: var(--sage); overflow: hidden; }
  .lookout .eyebrow .chip { margin-left: 4px; }
  .lookout__reports { display: grid; gap: 20px; margin-bottom: clamp(56px, 8vw, 110px); }
  @media (min-width: 820px) { .lookout__reports { grid-template-columns: 1fr 1fr; } }
  .lookout__card { background: color-mix(in srgb, var(--birch) 80%, transparent); }
  .lookout__kicker { color: var(--fern); margin-bottom: 12px; }
  .lookout__card .h3 { margin-bottom: 12px; }
  .lookout__card > p { color: var(--ink-soft); }
  .lookout__card ul { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 10px; }
  .lookout__card li { display: flex; gap: 12px; align-items: baseline; font-size: 15.5px; }
  .lookout__card li::before {
    content: "";
    flex-shrink: 0;
    width: 14px;
    height: 2px;
    background: var(--lantern);
    transform: translateY(-4px);
  }

  .lookout__stage { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 980px) { .lookout__stage { grid-template-columns: 1.25fr 0.75fr; gap: 72px; } }

  .lookout__cta {
    margin-top: clamp(56px, 8vw, 100px);
    display: grid;
    gap: 24px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) { .lookout__cta { grid-template-columns: 1fr auto; align-items: center; } }
  .lookout__cta p { margin: 0; font-family: var(--font-display); font-size: clamp(20px, 2vw, 26px); line-height: 1.35; max-width: 34ch; }
  .lookout__btns { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
