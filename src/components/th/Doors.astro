---
// Services as four rooms in the forest. Each room is one of the painted
// objects from the hero, lifted out of the scene and set on the page.
import HiddenDango from "./forest/HiddenDango.astro";
import { useI18n } from "../../i18n";
const { t, l } = useI18n(Astro.url);
const d = t.doors!;
// which choice in the contact form each room selects (0 is the free AI check)
const art: Record<string, { src: string; w: number; h: number; interest: number }> = {
  basket: { src: "/forest/objects/chanterelles.webp", w: 934, h: 792, interest: 1 },
  treehouse: { src: "/forest/objects/treehouse.webp", w: 577, h: 960, interest: 2 },
  dock: { src: "/forest/objects/dock.webp", w: 960, h: 576, interest: 3 },
  campfire: { src: "/forest/objects/campfire.webp", w: 960, h: 619, interest: 4 },
};
const rooms = d.items.map((r, i) => ({ ...r, ...art[r.id], no: String(i + 1).padStart(2, "0") }));
---

<section id="rooms" class="section rooms doors" data-rooms data-floor={d.floor} aria-labelledby="rooms-title">
  <div class="wrap">
    <div class="section-head section-head--split">
      <HiddenDango id="rooms" prop="paint" side="right" />
      <div>
        <p class="eyebrow">{d.eyebrow}</p>
        <h2 id="rooms-title" class="h2" data-split set:html={d.title} />
      </div>
      <p class="lede" data-reveal>{d.lede}</p>
    </div>

    <div class="doors__grid">
      <figure class="doors__figure" aria-hidden="true">
        <div class="doors__stage">
          <span class="doors__light"></span>
          {rooms.map((r) => (
            <img class={`doors__obj doors__obj--${r.id} zone`} data-zone={r.id} src={r.src} width={r.w} height={r.h} alt="" loading="lazy" decoding="async" />
          ))}
          <span class="doors__ground"></span>
        </div>
      </figure>

      <ol class="doors__list">
        {rooms.map((r) => (
          <li class="door card" data-room={r.id} data-reveal>
            <img class={`door__art door__art--${r.id}`} src={r.src} width={r.w} height={r.h} alt={r.alt} loading="lazy" decoding="async" />
            <div class="door__meta mono"><span>{r.no}</span><span>{r.room}</span></div>
            <h3 class="h3">{r.title}</h3>
            <p>{r.body}</p>
            <ul class="door__chips">
              {r.chips.map((c) => <li class="chip">{c}</li>)}
            </ul>
            <div class="door__foot">
              <span class="door__price">{d.price}</span>
              <a class="link-arrow" href="#contact" data-interest={r.interest}>{d.ask} <span aria-hidden="true">→</span></a>
            </div>
          </li>
        ))}
        <li class="door door--start" data-reveal>
          <h3 class="h3">{d.start.title}</h3>
          <p>{d.start.body}</p>
          <a class="btn" href={l("/contact/")} data-magnetic>{d.start.cta} <span class="btn-arrow">→</span></a>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .doors { background: var(--birch); }
  .doors__grid { display: grid; gap: 40px; }
  @media (min-width: 960px) {
    .doors__grid { grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  }

  /* the painted object of the room you are reading, standing in a pool of afternoon light */
  .doors__figure { margin: 0; display: none; }
  @media (min-width: 960px) { .doors__figure { display: block; } }
  .doors__stage {
    position: sticky;
    top: calc(50vh - 270px);
    height: 540px;
  }
  .doors__light {
    position: absolute;
    inset: 4% 2% 10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 214, 140, 0.55), rgba(255, 214, 140, 0.18) 55%, rgba(255, 214, 140, 0) 100%);
    filter: blur(8px);
  }
  .doors__ground {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 5%;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(70, 48, 24, 0.22), rgba(70, 48, 24, 0));
  }
  .doors__obj {
    position: absolute;
    left: 50%;
    bottom: 7%;
    max-width: 86%;
    max-height: 88%;
    width: auto;
    height: auto;
    transform: translate(-50%, 18px) scale(0.94);
    transform-origin: 50% 100%;
    opacity: 0;
    filter: blur(3px) saturate(0.9);
    transition: opacity 0.9s var(--ease-out), transform 1.1s var(--ease-out), filter 0.9s var(--ease-out);
    z-index: 1;
  }
  .doors__obj--treehouse { max-height: 96%; bottom: 5%; }
  .doors__obj.is-lit { opacity: 1; transform: translate(-50%, 0) scale(1); filter: none; }
  :global(html.motion) .doors__obj.is-lit { animation: door-breathe 7s ease-in-out 1.2s infinite; }
  @keyframes door-breathe { 50% { transform: translate(-50%, -6px) scale(1.01); } }

  .doors__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  @media (min-width: 960px) {
    .doors__list { gap: 16vh; padding-block: 6vh 10vh; }
  }
  .door { transition: border-color 0.5s, box-shadow 0.6s var(--ease-out), background 0.5s; }
  .door.is-active {
    border-color: color-mix(in srgb, var(--sun, #f2c25e) 80%, transparent);
    box-shadow: 0 30px 70px -40px rgba(150, 90, 20, 0.5);
    background: var(--card-lit);
  }
  /* on small screens each room carries its own painting */
  .door__art { display: block; height: 150px; width: auto; max-width: 70%; margin: -6px auto 14px; object-fit: contain; }
  .door__art--treehouse { height: 190px; }
  @media (min-width: 960px) { .door__art { display: none; } }
  .door__meta { display: flex; align-items: center; gap: 14px; color: var(--fern); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 16px; }
  .door__meta span:first-child { color: var(--gold-ink, var(--wood)); }
  .door .h3 { margin-bottom: 14px; font-size: clamp(28px, 3vw, 38px); }
  .door p { color: var(--ink-soft); }
  .door__chips { list-style: none; margin: 18px 0 24px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .door__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
  }
  .door__price { font-size: 14px; color: var(--muted); }

  .door--start {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius);
    border: 1px dashed color-mix(in srgb, var(--wood) 45%, transparent);
    background: color-mix(in srgb, var(--sun, #f2c25e) 12%, transparent);
  }
  .door--start .h3 { font-size: clamp(24px, 2.4vw, 30px); }
  .door--start p { margin-bottom: 22px; max-width: 44ch; }
</style>

<script>
  // "Ask about this room" opens the contact form with that room already chosen
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>("[data-interest]");
    if (!a) return;
    const n = Number(a.dataset.interest);
    const inputs = document.querySelectorAll<HTMLInputElement>('#contact input[name="service"]');
    if (inputs[n]) inputs[n].checked = true;
  });
</script>
