---
import { useI18n } from "../../i18n";
const { t } = useI18n(Astro.url);
const facts = t.founder.facts;
---

<section id="founder" class="section founder" data-floor={t.founder.floor} aria-labelledby="founder-title">
  <div class="wrap founder__grid">
    <div class="founder__art" data-reveal="scale">
      <div class="founder__ring">
        <svg viewBox="0 0 200 200" aria-hidden="true" class="founder__text">
          <defs><path id="circle-path" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
          <text><textPath href="#circle-path">{t.founder.ring}</textPath></text>
        </svg>
        <img src="/Umaru-Creative-Dango-blue.png" alt={t.founder.logoAlt} width="160" height="160" />
      </div>
    </div>

    <div class="founder__copy">
      <p class="eyebrow">{t.founder.eyebrow}</p>
      <h2 id="founder-title" class="h2" data-split set:html={t.founder.title} />
      <div class="founder__body" data-reveal>
        {t.founder.body.map((para) => <p>{para}</p>)}
      </div>
      <dl class="founder__facts" data-stagger>
        {facts.map((f) => (
          <div>
            <dt class="mono">{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .founder { background: var(--birch); }
  .founder__grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 900px) { .founder__grid { grid-template-columns: 0.8fr 1.2fr; gap: 96px; } }
  .founder__art { display: grid; place-items: center; }
  .founder__ring {
    position: relative;
    width: min(100%, 380px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: radial-gradient(circle, var(--lantern-soft) 0%, var(--sage) 62%, transparent 63%);
  }
  .founder__ring img { width: 42%; height: auto; position: relative; z-index: 1; animation: bob 6s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-8px) rotate(-3deg); } }
  .founder__text { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 40s linear infinite; }
  .founder__text text { font: 500 11.5px var(--font-mono); letter-spacing: 0.22em; text-transform: uppercase; fill: var(--moss); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .founder__copy .h2 { margin-bottom: 30px; }
  .founder__body { font-size: 18px; color: var(--ink-soft); max-width: 54ch; }
  .founder__facts { margin: 40px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px 28px; }
  .founder__facts div { border-top: 1px solid var(--line); padding-top: 14px; }
  .founder__facts dt { color: var(--muted); font-size: 11px; margin-bottom: 6px; }
  .founder__facts dd { margin: 0; font-family: var(--font-display); font-size: 19px; line-height: 1.3; }
</style>
