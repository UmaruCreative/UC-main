---
// Why now: every page is read twice, first by AI and then by a person.
import { useI18n } from "../../i18n";
const { t } = useI18n(Astro.url);
const r = t.readers!;
---

<section id="why" class="section readers" data-floor={r.floor} aria-labelledby="readers-title">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">{r.eyebrow}</p>
        <h2 id="readers-title" class="h2" data-split set:html={r.title} />
      </div>
      <p class="lede" data-reveal>{r.lede}</p>
    </div>

    <ol class="readers__pair" data-stagger>
      {r.items.map((it, i) => (
        <li class="reader card">
          <span class="reader__no" aria-hidden="true">{i + 1}</span>
          <p class="reader__kicker mono">{it.kicker}</p>
          <h3 class="h3">{it.title}</h3>
          <p>{it.body}</p>
          <p class="reader__need mono">{it.need}</p>
        </li>
      ))}
      <li class="readers__arrow" aria-hidden="true">
        <svg viewBox="0 0 120 40" width="120" height="40"><path d="M6 24 C 34 6, 70 6, 104 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="3 6" /><path d="M96 12 L106 20 L95 27" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
    </ol>

    <p class="readers__close" data-reveal>{r.close}</p>
  </div>
</section>

<style>
  .readers { background: var(--paper); }
  .readers__pair {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  @media (min-width: 860px) {
    .readers__pair { grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 120px); }
  }
  .reader { position: relative; overflow: hidden; padding-top: clamp(30px, 3.4vw, 44px); }
  .reader__no {
    position: absolute;
    right: clamp(18px, 2.4vw, 30px);
    top: -0.12em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(110px, 12vw, 170px);
    line-height: 1;
    color: color-mix(in srgb, var(--sun, #f2c25e) 34%, transparent);
    pointer-events: none;
  }
  .reader__kicker { color: var(--fern); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 10px; }
  .reader .h3 { font-size: clamp(34px, 3.6vw, 48px); margin-bottom: 14px; }
  .reader p { color: var(--ink-soft); max-width: 46ch; position: relative; }
  .reader__need {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--gold-ink, var(--wood));
  }
  .readers__arrow { display: none; }
  @media (min-width: 860px) {
    .readers__arrow {
      display: block;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      color: var(--wood);
      opacity: 0.8;
    }
    .readers__arrow svg { width: clamp(60px, 7vw, 110px); height: auto; }
  }
  .readers__close {
    margin: clamp(40px, 6vw, 72px) auto 0;
    max-width: 30ch;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.3;
    color: var(--ink);
  }
</style>
