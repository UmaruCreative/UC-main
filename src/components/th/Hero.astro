---
// The forest hero: you sit halfway up an old spruce by a Finnish lake.
// One painting, brought to life by src/scripts/forest.ts.
import { useI18n } from "../../i18n";
import { SEASON, DANGO } from "../../season";
const { t, l } = useI18n(Astro.url);
---

<section class="hero fh" data-hero data-forest-hero data-night data-floor={t.hero.floor} aria-labelledby="hero-title">
  <div class="fh__stage" data-forest-stage>
    <picture class="fh__still" data-forest-still>
      <source media="(max-aspect-ratio: 4/5)" srcset="/forest/forest-m-720.webp 720w, /forest/forest-m-1440.webp 1440w" sizes="100vw" />
      <img
        src="/forest/forest-d-1280.webp"
        srcset="/forest/forest-d-1280.webp 1280w, /forest/forest-d-2560.webp 2560w"
        sizes="100vw"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <canvas class="fh__gl" data-forest-gl aria-hidden="true"></canvas>
    <canvas class="fh__fx" data-forest-fx aria-hidden="true"></canvas>
    <canvas class="season-fx fh__fall" data-season-fx={SEASON} data-from="0.2" data-density="0.7" aria-hidden="true"></canvas>

    <div class="fh__dango" data-forest-dango aria-hidden="true">
      <span class="fh__float">
        <span class="fh__shadow"></span>
        <span class="fh__body"><img src={DANGO.src} alt="" width="141" height="320" /></span>
      </span>
    </div>

    <div class="fh__shade" aria-hidden="true"></div>

    <div class="hero__copy wrap" data-hero-copy>
      <p class="eyebrow" data-hero-in>{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="display" data-split set:html={t.hero.title} />
      <p class="lede" data-hero-in>{t.hero.lede}</p>
      <div class="hero__ctas" data-hero-in>
        <a href={l("/contact/")} class="btn" data-magnetic>{t.hero.cta} <span class="btn-arrow">→</span></a>
        <a href="#rooms" class="btn btn--ghost" data-magnetic>{t.hero.explore}</a>
      </div>
    </div>

    <div class="hero__foot wrap" data-hero-in>
      <ul class="hero__facts mono">
        {t.hero.facts.map((f) => <li>{f}</li>)}
      </ul>
      <a href="#rent" class="hero__cue mono">
        <span class="hero__cue-rope" aria-hidden="true"></span>
        {t.hero.climb}
      </a>
    </div>
  </div>
</section>

<style>
  /* Full bleed. With motion the hero is tall: scrolling lowers your gaze
     from the treehouse to the forest floor while the stage stays put. */
  .fh {
    --fh-p: 0;
    position: relative;
    height: 100svh;
    min-height: 560px;
    background: #2b2a1c;
  }
  :global(html.motion) .fh { height: 230svh; }
  .fh__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .fh__still,
  .fh__gl,
  .fh__fx,
  .fh__fall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -3;
    pointer-events: none;
  }
  .fh__still img { width: 100%; height: 100%; object-fit: cover; display: block; transform-origin: 62% 13%; transform: scale(1.38); object-position: 62% 13%; }
  .fh__gl { z-index: -2; opacity: 0; transition: opacity 1s ease; }
  .fh.is-live .fh__gl { opacity: 1; }
  .fh__fx { z-index: -1; }
  .fh__fall { z-index: -1; }

  /* Light for the words: a soft shade on the side the text sits on, gone once you look down */
  .fh__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(14, 20, 13, 0.66) 0%, rgba(14, 20, 13, 0.4) 30%, rgba(14, 20, 13, 0) 60%),
      linear-gradient(0deg, rgba(12, 16, 11, 0.55) 0%, rgba(12, 16, 11, 0) 24%);
    opacity: clamp(0, calc(1 - var(--fh-p) * 2.2), 1);
    transition: opacity 0.6s ease;
  }
  /* once the painting is alive it lowers its own light behind the words,
     so the flat shade can step back and leave the forest clear */
  .fh.is-live .fh__shade { opacity: clamp(0, calc((1 - var(--fh-p) * 2.2) * 0.55), 1); }

  /* Dango: the original artwork, lit by the forest */
  .fh__dango {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    height: var(--dh, 60px);
    aspect-ratio: 141 / 320;
    cursor: pointer;
    opacity: 0;
    transition: opacity 1.4s ease;
    will-change: transform;
  }
  .fh.has-dango .fh__dango { opacity: 1; }
  .fh__float {
    position: absolute;
    inset: 0;
    transition: opacity 0.9s ease, transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.9s ease;
  }
  .fh__dango.is-away .fh__float { opacity: 0; transform: translateY(-18%) scale(0.88); filter: blur(2px); }
  .fh__dango.is-arriving .fh__float { animation: fh-arrive 1.2s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes fh-arrive { from { opacity: 0; transform: translateY(-22%) scale(0.9); filter: blur(2px) brightness(1.4); } }
  .fh__dango.is-hop .fh__float { animation: fh-hop 0.7s cubic-bezier(0.3, 0.7, 0.3, 1); }
  @keyframes fh-hop { 40% { transform: translateY(-16%) scaleY(1.04); } 70% { transform: translateY(0) scaleY(0.94); } }
  .fh__body { position: absolute; inset: 0; display: block; transform-origin: 50% 100%; }
  :global(html.motion) .fh__body { animation: fh-breathe 4.6s ease-in-out infinite; }
  @keyframes fh-breathe { 50% { transform: translateY(-3%) scaleY(1.015); } }
  .fh__body img {
    width: 100%;
    height: 100%;
    display: block;
    transform-origin: 50% 100%;
    transform: rotate(var(--lean, 0deg));
    transition: transform 0.7s ease, filter 0.7s ease;
    /* warm light from the low sun on the upper left */
    filter: drop-shadow(-1px -1px 1.5px rgba(255, 228, 168, 0.65)) drop-shadow(0 0 5px rgba(255, 210, 140, 0.35)) saturate(1.04);
  }
  .fh__dango.is-near .fh__body img {
    filter: drop-shadow(-1px -1px 1.5px rgba(255, 232, 180, 0.8)) drop-shadow(0 0 10px rgba(180, 230, 255, 0.55)) saturate(1.08);
  }
  .fh__shadow {
    position: absolute;
    left: 50%;
    bottom: -3%;
    width: 120%;
    height: 9%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(20, 16, 8, 0.45), rgba(20, 16, 8, 0));
  }

  /* Words over the forest */
  .hero__copy {
    padding-top: calc(var(--header-h) + clamp(32px, 8vh, 110px));
    position: relative;
    color: var(--night-ink);
    opacity: clamp(0, calc(1 - var(--fh-p) * 3), 1);
    transform: translateY(calc(var(--fh-p) * -80px));
    pointer-events: none;
  }
  .hero__copy > * { pointer-events: auto; }
  .hero__copy .eyebrow { color: #f8e6bb; letter-spacing: 0.12em; text-shadow: 0 0 14px rgba(24, 16, 6, 0.75), 0 1px 2px rgba(24, 16, 6, 0.6); }
  .hero__copy .display { max-width: 9.5ch; margin-bottom: 28px; color: #fdf8ec; text-shadow: 0 0 28px rgba(24, 16, 6, 0.45), 0 2px 6px rgba(24, 16, 6, 0.3); }
  :global(html:lang(fi)) .hero__copy .display { max-width: 13.5ch; }
  .hero__copy .display :global(em) { color: #ffcb66; text-shadow: 0 0 26px rgba(40, 22, 4, 0.55), 0 2px 6px rgba(40, 22, 4, 0.35); }
  .hero__copy .lede {
    max-width: 42ch;
    color: #fdf8ec;
    font-weight: 500;
    margin-bottom: 34px;
    /* a soft dark halo, not a hard shadow */
    text-shadow: 0 0 18px rgba(24, 16, 6, 0.7), 0 0 4px rgba(24, 16, 6, 0.45), 0 1px 2px rgba(24, 16, 6, 0.5);
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; pointer-events: none; }
  .hero__ctas > * { pointer-events: auto; }
  .hero__ctas .btn--ghost {
    color: #fbf6ea;
    border-color: rgba(251, 246, 234, 0.55);
    background: rgba(18, 24, 16, 0.32);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero__foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 28px;
    color: var(--birch);
    opacity: clamp(0, calc(1 - var(--fh-p) * 4), 1);
    pointer-events: none;
  }
  .hero__foot > * { pointer-events: auto; }
  .hero__facts { display: flex; flex-wrap: wrap; gap: 8px 22px; list-style: none; margin: 0; padding: 0; }
  .hero__facts li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--night) 55%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .hero__facts li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--glow); box-shadow: 0 0 8px var(--glow); }
  .hero__cue {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--night) 55%, transparent);
  }
  .hero__cue-rope {
    width: 1.5px;
    height: 44px;
    background: repeating-linear-gradient(to bottom, currentColor 0 5px, transparent 5px 8px);
    animation: rope 1.6s linear infinite;
  }
  @keyframes rope { to { background-position: 0 16px; } }

  @media (max-aspect-ratio: 4/5) {
    .fh__still img { transform-origin: 84% 20%; object-position: 84% 20%; transform: scale(1.32); }
    .fh__shade {
      background:
        linear-gradient(180deg, rgba(14, 20, 13, 0.62) 0%, rgba(14, 20, 13, 0.34) 42%, rgba(14, 20, 13, 0) 62%),
        linear-gradient(0deg, rgba(12, 16, 11, 0.5) 0%, rgba(12, 16, 11, 0) 22%);
    }
  }
  @media (max-width: 760px) {
    /* the words sit a little higher, above the bright mist on the lake */
    .hero__copy { padding-top: calc(var(--header-h) + clamp(12px, 3vh, 36px)); }
    .hero__copy .display { font-size: clamp(44px, 13vw, 68px); }
    .hero__copy .lede { font-size: 17px; }
    .hero__foot { flex-direction: column; align-items: flex-start; gap: 18px; }
    .hero__cue { display: none; }
  }
</style>

<script>
  import { initForest } from "../../scripts/forest";
  initForest();
</script>
