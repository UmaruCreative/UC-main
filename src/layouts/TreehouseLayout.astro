---
import "../styles/treehouse.css";
import Header from "../components/th/Header.astro";
import Footer from "../components/th/Footer.astro";
import LadderRail from "../components/th/LadderRail.astro";
import { useI18n, switchPath, langs } from "../i18n";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  rail?: boolean;
}

const { lang, t } = useI18n(Astro.url);
const { title, description = t.meta.home.description, canonical, rail = false } = Astro.props;

const htmlLang = lang === "no" ? "nb" : lang;
const ogLocale = { en: "en_GB", fi: "fi_FI", sv: "sv_SE", fr: "fr_FR", no: "nb_NO" }[lang];
const site = "https://umaru-creative.com";
// Articles exist in English only, so they don't advertise translations
const isArticle = Astro.url.pathname.includes("/articles/");
const alternates = isArticle ? [] : langs.map((code) => ({ code, href: site + switchPath(Astro.url, code) }));
---

<!doctype html>
<html lang={htmlLang} class="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee2" />
    <link rel="icon" type="image/png" href="/Umaru-Creative-Dango-blue.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <!-- Motion is opt in: without JS, or with reduced motion, everything renders in its final state -->
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
      }
    </script>

    <slot name="head" />
  </head>
  <body class="th-body">
    <a class="skip-link" href="#main">{t.common.skip}</a>
    <Header />
    {rail && <LadderRail />}
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initMotion } from "../scripts/treehouse";
      initMotion();
    </script>
  </body>
</html>
