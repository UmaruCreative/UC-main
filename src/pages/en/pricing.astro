---
import TreehouseLayout from "../../layouts/TreehouseLayout.astro";
import PageHero from "../../components/th/PageHero.astro";
import CtaBand from "../../components/th/CtaBand.astro";

type Plan = { name: string; sub: string; price: string; items?: string[]; popular?: boolean; cta?: string; href?: string };
const groups: { id: string; kicker: string; title: string; note?: string; plans: Plan[] }[] = [
  {
    id: "websites",
    kicker: "Website creation",
    title: "Build your <em>treehouse.</em>",
    note: "All packages can be upgraded with a 6 month Website Care Plan. Flexible monthly payment plans are available, just ask.",
    plans: [
      { name: "Landing page", sub: "Compact one page design", price: "From €990", items: ["Custom design", "Contact section", "Around 200 words of SEO content", "4 visuals", "Basic SEO", "1 revision"] },
      { name: "Enhanced website", sub: "Flexible multi page site, 2 to 5 pages", price: "€1,290 to €1,890", popular: true, items: ["2 to 5 custom pages", "Contact form", "Around 700 words of SEO content", "Up to 12 visuals", "Basic SEO plus multilingual option", "2 revisions"] },
      { name: "Professional or e-commerce", sub: "Full featured website or online shop", price: "From €2,190", items: ["Product integration and payments", "Advanced SEO", "Custom layouts", "Up to 3 revisions"] },
    ],
  },
  {
    id: "reports",
    kicker: "Weekly reports · new",
    title: "See over <em>the canopy.</em>",
    note: "Every report is researched for your market, so pricing follows your scope: competitors tracked, questions monitored, and one report or both.",
    plans: [
      { name: "Weekly market research", sub: "Competitors, buyer searches, AI visibility", price: "Bespoke", items: ["Competitor moves", "What your buyers search for", "Visibility in Google and AI answers", "Local and seasonal signals", "Prioritised action list"], cta: "Get a quote", href: "/en/contact/?service=reports" },
      { name: "Weekly web analytics", sub: "How your own site really performed", price: "Bespoke", items: ["Visits and sources", "Pages that lead to enquiries", "Searches that found you", "Privacy first measurement", "Plain English summary"], cta: "Get a quote", href: "/en/contact/?service=reports" },
      { name: "Both, together", sub: "The full view from the lookout", price: "Bespoke", popular: true, items: ["Market and analytics in one read", "One shared action list", "Sources for every claim"], cta: "Request a sample", href: "/en/contact/?service=reports" },
    ],
  },
  {
    id: "care",
    kicker: "Ongoing support",
    title: "Keep it in <em>good repair.</em>",
    plans: [
      { name: "Hourly support", sub: "Occasional updates, design tweaks or maintenance", price: "€60/hour", items: ["Pay only for what you need"] },
      { name: "Website improvements", sub: "Already have a website?", price: "From €590", items: ["Clearer navigation", "Better user experience", "Visual clarity", "Stronger messaging"] },
    ],
  },
  {
    id: "video",
    kicker: "Video content",
    title: "Stories for <em>the window.</em>",
    note: "Starting prices are for editing footage you provide. Filming on location is priced separately, as shown on each card.",
    plans: [
      { name: "Short and snappy", sub: "Less than 30 seconds", price: "From €270", items: ["Editing footage you provide", "Filmed on location: from €390", "Perfect for ads, reels or teasers"] },
      { name: "Engaging story", sub: "30 to 60 seconds", price: "From €450", items: ["Editing footage you provide", "Filmed on location: from €590", "Perfect for Instagram and Facebook posts or product showcases"] },
      { name: "Mini documentary", sub: "1 to 3 minutes", price: "From €590", items: ["Editing footage you provide", "Filmed on location: from €790", "Perfect for brand storytelling, service highlights or YouTube"] },
    ],
  },
  {
    id: "local",
    kicker: "Local presence",
    title: "A signpost <em>on the map.</em>",
    plans: [
      { name: "Google Business Profile upgrade", sub: "Google Maps and Search", price: "From €450", items: ["Setup and verification", "Photos and categories", "Review strategy"] },
    ],
  },
];
---

<TreehouseLayout
  title="Pricing | Umaru Creative"
  description="Clear, transparent prices for websites, website care, video content, Google Business Profile and bespoke weekly market research and web analytics reports."
  canonical="https://umaru-creative.com/en/pricing/"
>
  <PageHero
    eyebrow="Pricing"
    title="Clear prices for <em>every plot.</em>"
    lede="Affordable and transparent, with no hidden costs. Choose the rooms you need today and add more as you grow."
    crumbs={[{ label: "Home", href: "/en/" }, { label: "Pricing" }]}
    primary={{ label: "Book a free consultation", href: "/en/contact/" }}
  />

  <nav class="pnav" aria-label="Pricing sections">
    <ul class="wrap">
      {groups.map((g) => <li><a href={`#${g.id}`}>{g.kicker.replace(" · new", "")}</a></li>)}
    </ul>
  </nav>

  {groups.map((g, gi) => (
    <section id={g.id} class:list={["section", "pgroup", gi % 2 ? "section--birch" : ""]}>
      <div class="wrap">
        <div class="section-head section-head--split">
          <div>
            <p class="eyebrow">{g.kicker}</p>
            <h2 class="h2" data-split set:html={g.title} />
          </div>
          {g.note && <p class="lede" data-reveal>{g.note}</p>}
        </div>
        <ul class="plans" data-stagger>
          {g.plans.map((p) => (
            <li class:list={["plan", { "plan--popular": p.popular }]}>
              {p.popular && <span class="plan__badge mono">{g.id === "reports" ? "Best view" : "Popular"}</span>}
              <h3>{p.name}</h3>
              <p class="plan__sub">{p.sub}</p>
              <p class="plan__price">{p.price}</p>
              {p.items && (
                <ul class="plan__items">{p.items.map((i) => <li>{i}</li>)}</ul>
              )}
              <a href={p.href ?? "/en/contact/"} class="btn plan__cta">{p.cta ?? "Get started"} <span class="btn-arrow">→</span></a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <CtaBand
    title="Not sure which <em>rooms you need?</em>"
    body="Let’s talk it through. A free consultation, honest advice, and a plan that fits your business."
    primary={{ label: "Book a free consultation", href: "/en/contact/" }}
    secondary={{ label: "See my work", href: "/en/#portfolio" }}
  />
</TreehouseLayout>

<style>
  .pnav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-block: 1px solid var(--line);
  }
  .pnav ul { display: flex; gap: 6px; list-style: none; margin: 0 auto; padding-block: 12px; overflow-x: auto; scrollbar-width: none; }
  .pnav a {
    display: block;
    white-space: nowrap;
    padding: 9px 16px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.3s;
  }
  .pnav a:hover { background: var(--sage); }
  .pgroup { padding-block: clamp(72px, 9vw, 130px); }
  .pgroup .section-head { margin-bottom: clamp(36px, 5vw, 64px); }

  .plans { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 3vw, 38px);
    border-radius: var(--radius);
    background: var(--birch);
    border: 1px solid var(--line);
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  .section--birch .plan { background: var(--paper); }
  .plan:hover { transform: translateY(-6px); box-shadow: 0 40px 70px -46px rgba(27, 38, 32, 0.55); }
  .plan--popular { background: var(--night) !important; color: var(--night-ink); border-color: transparent; }
  .plan__badge {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--lantern);
    color: var(--night);
    font-size: 10.5px;
  }
  .plan h3 { font-size: 26px; margin-bottom: 8px; padding-right: 90px; }
  .plan__sub { color: var(--ink-soft); font-size: 15px; }
  .plan--popular .plan__sub { color: var(--night-muted); }
  .plan__price { font-family: var(--font-display); font-size: clamp(34px, 3.4vw, 46px); line-height: 1.1; margin: 10px 0 22px !important; letter-spacing: -0.02em; }
  .plan--popular .plan__price { color: var(--lantern); }
  .plan__items { list-style: none; margin: 0 0 28px; padding: 22px 0 0; border-top: 1px dashed var(--line); display: grid; gap: 10px; font-size: 15px; }
  .plan--popular .plan__items { border-color: rgba(233, 228, 214, 0.15); }
  .plan__items li { display: flex; gap: 10px; align-items: baseline; }
  .plan__items li::before { content: "✓"; color: var(--fern); font-weight: 600; }
  .plan--popular .plan__items li::before { color: var(--lantern); }
  .plan__cta { margin-top: auto; align-self: flex-start; }
  .plan--popular .plan__cta { --btn-bg: var(--lantern); --btn-fg: var(--night); }
  .plan--popular .plan__cta::before { background: var(--birch); }
</style>
