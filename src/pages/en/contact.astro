---
import TreehouseLayout from "../../layouts/TreehouseLayout.astro";
import Contact from "../../components/th/Contact.astro";
import Faq from "../../components/th/Faq.astro";

const faqs = [
  {
    q: "What happens after I send a message?",
    a: "I reply within two business days, usually with a few questions about your business and goals. If it helps, we book a short call. Then you receive a clear proposal with scope, timeline and price before anything starts.",
  },
  {
    q: "Can we talk on the phone or by video?",
    a: "Of course. Email me first with a couple of times that suit you, and I’ll confirm a slot for a call.",
  },
  {
    q: "Do you work with businesses outside Jyväskylä?",
    a: "Yes. I’m based in Jyväskylä but work with clients across Finland and beyond. Everything can be done remotely.",
  },
];
---

<TreehouseLayout
  title="Contact | Umaru Creative"
  description="Start a conversation with Umaru Creative, a web studio in Jyväskylä. Websites, weekly market research and web analytics reports for small businesses."
  canonical="https://umaru-creative.com/en/contact/"
>
  <div class="contact-page">
    <Contact as="h1" />
  </div>
  <Faq items={faqs} title="Before you knock" />
</TreehouseLayout>

<style>
  .contact-page :global(.contact) { padding-top: calc(var(--header-h) + clamp(60px, 9vw, 120px)); }
</style>
