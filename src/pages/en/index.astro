---
import TreehouseLayout from "../../layouts/TreehouseLayout.astro";
import Hero from "../../components/th/Hero.astro";
import RentOwn from "../../components/th/RentOwn.astro";
import Rooms from "../../components/th/Rooms.astro";
import Lookout from "../../components/th/Lookout.astro";
import Security from "../../components/th/Security.astro";
import Build from "../../components/th/Build.astro";
import Neighbours from "../../components/th/Neighbours.astro";
import Portfolio from "../../components/th/Portfolio.astro";
import Founder from "../../components/th/Founder.astro";
import Faq from "../../components/th/Faq.astro";
import FieldNotes from "../../components/th/FieldNotes.astro";
import Contact from "../../components/th/Contact.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Umaru Creative",
  description:
    "Handcrafted, secure web design plus bespoke weekly market research and web analytics reports for small businesses, cafés and creatives in Jyväskylä, Finland.",
  url: "https://umaru-creative.com/en/",
  email: "umaru.creative@gmail.com",
  address: { "@type": "PostalAddress", addressLocality: "Jyväskylä", addressRegion: "Central Finland", addressCountry: "FI" },
  areaServed: [{ "@type": "City", name: "Jyväskylä" }, { "@type": "Country", name: "Finland" }],
  serviceType: [
    "Web Design",
    "Website Development",
    "Digital Content",
    "Google Business Profile Optimisation",
    "Weekly Market Research Reports",
    "Web Analytics Reports",
  ],
  priceRange: "€€",
  foundingDate: "2025",
  sameAs: ["https://techbehemoths.com/company/umaru-creative"],
};
---

<TreehouseLayout
  title="Secure Web Design and Weekly Market Reports in Jyväskylä | Umaru Creative"
  description="Handcrafted, secure websites you own outright, plus bespoke weekly market research and web analytics reports for small businesses in Jyväskylä and across Finland."
  canonical="https://umaru-creative.com/en/"
  rail
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Hero />
  <RentOwn />
  <Rooms />
  <Lookout />
  <Security />
  <Build />
  <Neighbours />
  <Portfolio />
  <Founder />
  <Faq />
  <FieldNotes />
  <Contact />
</TreehouseLayout>
