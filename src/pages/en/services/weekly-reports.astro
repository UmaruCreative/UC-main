---
import TreehouseLayout from "../../../layouts/TreehouseLayout.astro";
import PageHero from "../../../components/th/PageHero.astro";
import Lookout from "../../../components/th/Lookout.astro";
import Faq from "../../../components/th/Faq.astro";
import CtaBand from "../../../components/th/CtaBand.astro";

const faqs = [
  {
    q: "Where does the information come from?",
    a: "Public sources such as competitors’ websites and social channels, search trend tools, Google results and AI assistants, plus your own website analytics. Every claim in the report names its source, so you can check it yourself.",
  },
  {
    q: "Can I get the reports without a website built by you?",
    a: "Yes. The market research report works for any business. For the web analytics report I need access to your site’s analytics, or I can set up privacy first measurement for you.",
  },
  {
    q: "How are the reports priced?",
    a: "Each report is bespoke, so the price depends on your market, how many competitors and questions we track, and whether you want one report or both. Tell me about your business and I’ll send a clear quote.",
  },
  {
    q: "Is my data shared with anyone?",
    a: "No. Your reports go only to the people you choose, your analytics data stays yours and can be exported at any time, and nothing is sold or passed to ad networks.",
  },
  {
    q: "What if nothing important happened that week?",
    a: "Then the report says so, briefly. Quiet weeks are useful to know about too, and you never have to read padding.",
  },
];
---

<TreehouseLayout
  title="Weekly Market Research and Web Analytics Reports | Umaru Creative"
  description="Bespoke weekly market research and web analytics reports for small businesses and brands in Finland. Competitor moves, buyer searches and site performance, sourced and in plain English."
  canonical="https://umaru-creative.com/en/services/weekly-reports/"
>
  <PageHero
    tone="dusk"
    eyebrow="Weekly reports · new"
    title="See your market <em>before it moves.</em>"
    lede="Bespoke weekly market research and web analytics reports for businesses that can’t afford to be absent. Researched for you, delivered to your inbox, every claim sourced."
    crumbs={[{ label: "Home", href: "/en/" }, { label: "Services" }, { label: "Weekly Reports" }]}
    primary={{ label: "Request a sample", href: "/en/contact/?service=reports" }}
    secondary={{ label: "See what’s inside", href: "#lookout" }}
  />

  <Lookout compact />

  <section class="section section--birch">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 class="h2" data-split>Every week. <em>Every move.</em></h2>
        </div>
        <p class="lede" data-reveal>A short, structured read you can finish with your morning coffee, and know exactly where you stand.</p>
      </div>
      <ol class="steps3" data-stagger>
        <li>
          <p class="mono">01 · What’s scanned</p>
          <h3>Your market, not a template</h3>
          <p>Competitor activity, live buyer searches and your own search visibility, checked every week against your specific market and your own website data.</p>
        </li>
        <li>
          <p class="mono">02 · What lands in your inbox</p>
          <h3>A short, sourced report</h3>
          <p>That week’s findings only, each one sourced, with the numbers translated into plain English. No dashboard to log into, no jargon to decode.</p>
        </li>
        <li>
          <p class="mono">03 · What you do next</p>
          <h3>A prioritised action list</h3>
          <p>Every report ends with clear next steps. Urgent items flagged, quick wins for this week, and strategic moves noted for later.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--night" data-night>
    <div class="wrap split">
      <div>
        <p class="eyebrow">Privacy first</p>
        <h2 class="h2" data-split>Measured <em>without surveillance.</em></h2>
        <p class="lede" data-reveal>Good analytics don’t need to follow people around the internet. You learn what works on your site while your visitors keep their privacy, and you keep your data.</p>
      </div>
      <ul class="ticks" data-stagger>
        <li><span><strong>Privacy first measurement.</strong> Visitors are counted, not profiled or tracked across other sites.</span></li>
        <li><span><strong>Your data stays yours.</strong> Exportable at any time, never sold, never handed to ad networks.</span></li>
        <li><span><strong>Reports for your eyes only.</strong> Sent to the people you choose and nobody else.</span></li>
        <li><span><strong>Sources you can check.</strong> Every claim links back to where it came from.</span></li>
      </ul>
    </div>
  </section>

  <section class="section section--sage">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Who it’s for</p>
        <h2 class="h2" data-split>Built for crowded <em>categories.</em></h2>
        <p class="lede" data-reveal>Best suited to brands competing in a defined search category or retail channel, where being absent has a direct cost.</p>
        <ul class="ticks" data-stagger>
          <li>Cafés and bakeries in busy towns and city centres</li>
          <li>Food and drink brands selling through shops and markets</li>
          <li>Online shops competing on search and AI recommendations</li>
          <li>Local services where customers compare before they call</li>
        </ul>
      </div>
      <div class="card" data-reveal>
        <p class="mono" style="color: var(--fern); margin-bottom: 14px;">Pricing</p>
        <h3 class="h3" style="margin-bottom: 14px;">Bespoke, priced to your scope</h3>
        <p style="color: var(--ink-soft);">Every report is built around your market, so the quote depends on:</p>
        <ul class="ticks">
          <li>How many competitors we follow</li>
          <li>How many search and AI questions we track</li>
          <li>One report, or market research and analytics together</li>
          <li>How many markets or languages you sell in</li>
        </ul>
        <div style="margin-top: 28px;">
          <a href="/en/contact/?service=reports" class="btn" data-magnetic>Get a quote <span class="btn-arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Questions about the reports" />

  <CtaBand
    title="Climb up to <em>the lookout.</em>"
    body="Tell me about your market and I’ll send a sample report outline and a clear quote."
    primary={{ label: "Request a sample", href: "/en/contact/?service=reports" }}
    secondary={{ label: "All services", href: "/en/#rooms" }}
  />
</TreehouseLayout>
