---
import Layout from '../../layouts/Layout.astro';
import FiHeader from '../../components/FiHeader.astro';
import LoadingSpinner from '../../components/LoadingSpinner.astro';

const year = new Date().getFullYear();

const faqs = [
  {
    q: "Millaisia verkkosivustoja suunnittelet?",
    a: "Suunnittelen korkean konversion moderneja verkkosivustoja räätälöitynä brändillesi ja tavoitteillesi. Jokainen projekti rakennetaan alusta asti heijastamaan asemointiasi, yleisöäsi ja liiketoimintatavoitteitasi. Keskityn selkeyteen, suorituskykyyn ja konversioon — olitpa tarvitsemassa laskeutumissivua, portfoliota tai täysimittaista yrityssivustoa, joka todella tuottaa tuloksia."
  },
  {
    q: "Kuinka kauan tyypillinen projekti kestää?",
    a: "Useimmat projektit valmistuvat 2–4 viikossa laajuudesta ja monimutkaisuudesta riippuen. Aikataulut vaihtelevat sisällön valmiuden, muokkausten ja ominaisuusvaatimusten mukaan. Noudatan jäsenneltyä prosessia pitääkseen kaiken tehokkaana, selkeillä välitavoitteilla, jotta tiedät aina mitä tapahtuu ja milloin sivustosi on valmis."
  },
  {
    q: "Hoidatko myös sisällön ja tekstisuunnittelun?",
    a: "Kyllä, voin ohjata tai luoda verkkosivuston tekstisisällön brändisi ääneen sovitettuna. Jos sinulla ei ole valmista sisältöä, autan rakentamaan viestinnän, tarkentamaan arvolupauksen ja kirjoittamaan selkeän, konversiokeskeisen tekstin. Tämä varmistaa, että verkkosivustosi ei ainoastaan näytä hyvältä, vaan kommunikoi tehokkaasti ja ohjaa toimintaan."
  },
  {
    q: "Onko verkkosivustoni optimoitu mobiilille ja suorituskyvylle?",
    a: "Kyllä, jokainen verkkosivusto on täysin responsiivinen ja optimoitu nopeuden ja käytettävyyden suhteen. Sivustosi suunnitellaan toimimaan saumattomasti kaikilla laitteilla, nopeilla latausajoilla ja puhtaalla rakenteella. Tämä parantaa käyttäjäkokemusta, tukee hakukoneoptimointia ja varmistaa, että vierailijasi pysyvät sitoutuneina sen sijaan, että he poistuisivat hitaan suorituskyvyn vuoksi."
  },
  {
    q: "Voinko päivittää verkkosivustoa itse julkaisun jälkeen?",
    a: "Kyllä, voit helposti päivittää sisältöä ilman teknistä osaamista. Rakennan verkkosivustoja intuitiivisilla järjestelmillä, joiden avulla voit muokata tekstiä, kuvia ja perusosia itsenäisesti. Tarvittaessa tarjoan myös ohjausta, jotta tunnet itsesi varmaksi sivustosi hallinnassa sen julkaisun jälkeen."
  },
  {
    q: "Mikä tekee lähestymistavastasi erilaisen kuin muista suunnittelijoista?",
    a: "Keskityn strategialähtöiseen suunnitteluun, joka priorisoi selkeyden, asemoinnin ja konversion. Pelkän visuaalisen suunnittelun sijaan yhteensovitan rakenteen, viestinnän ja käyttäjäpolun liiketoimintatavoitteidesi kanssa. Tuloksena on verkkosivusto, joka ei ainoastaan näytä viimeistellyltä, vaan aktiivisesti tukee kasvuasi ja kommunikoi arvosi tehokkaasti."
  },
  {
    q: "Miten aloitamme yhteistyön?",
    a: "Ota yhteyttä, ja ohjaan sinut seuraaviin vaiheisiin. Aloitamme lyhyellä keskustelulla ymmärtääksemme tavoitteesi, laajuuden ja aikataulun. Sieltä hahmottelen selkeän suunnitelman ja ehdotuksen, jotta tiedät tarkalleen mitä odottaa ennen kuin siirrymme suunnitteluprosessiin."
  }
];
---

<Layout
  title="Verkkosuunnittelu pienyrityksille Jyväskylässä | Umaru Creative"
  description="Umaru Creative tarjoaa edullista, käsintehtyä verkkosuunnittelua pienyrityksille ja luoville ammattilaisille Jyväskylässä, Suomessa. Yksinkertaiset, turvalliset verkkosivut kestämään."
  lang="fi"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://umaru-creative.com/fi/" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Umaru Creative",
      "description": "Edullista, käsintehtyä verkkosuunnittelua pienyrityksille, kahviloille ja luoville ammattilaisille Jyväskylässä, Suomessa. Yksinkertainen, turvallinen ja kestämään rakennettu.",
      "url": "https://umaru-creative.com/fi/",
      "email": "umaru.creative@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jyväskylä",
        "addressRegion": "Keski-Suomi",
        "addressCountry": "FI"
      },
      "areaServed": [{"@type": "City", "name": "Jyväskylä"}, {"@type": "Country", "name": "Suomi"}],
      "serviceType": ["Verkkosuunnittelu", "Verkkosivuston kehitys", "Digitaalinen sisältö", "Google My Business -optimointi", "Markkinatieto"],
      "priceRange": "€€",
      "foundingDate": "2025",
      "sameAs": ["https://techbehemoths.com/company/umaru-creative"]
    }
    </script>
  </Fragment>

  <LoadingSpinner />
  <FiHeader />

  <!-- ═══════════════════════════════════════════════
       1. HERO
  ═══════════════════════════════════════════════ -->
  <section class="min-h-screen flex flex-col justify-center relative overflow-hidden pt-16 animate-on-scroll">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.pexels.com/photos/531756/pexels-photo-531756.jpeg?auto=compress&cs=tinysrgb&w=1920&h=1080&dpr=2"
        alt="Sininen taivas kelluvilla pilvilla"
        class="w-full h-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-primary-50/80 to-white/90"></div>
    </div>

    <img
      id="logo-char-1"
      src="/Dango-transparent.png"
      alt="Umaru Creative -logo"
      class="absolute w-96 h-96 opacity-90 z-20"
      style="right: 5%; bottom: 20%;"
    />
    <img
      id="logo-char-2"
      src="/Dango-transparent.png"
      alt="Umaru Creative -logo"
      class="absolute w-60 h-60 opacity-50 z-20"
      style="left: 18%; top: 50%;"
    />

    <div class="container mx-auto px-6 md:px-12 py-20 md:py-32 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-alexandria font-bold text-4xl md:text-5xl lg:text-6xl leading-tight mb-6">
          <span class="hero-line" data-delay="0">Verkkosivut rakennettu löydettäviksi —</span><br>
          <span class="hero-line" data-delay="0.5">ihmisille ja tekoälylle.</span>
        </h1>

        <p class="text-lg md:text-xl text-primary-800 mb-10 max-w-3xl mx-auto">
          <span class="hero-line" data-delay="1">Käsintehty pienyrityksille Jyväskylässä, Suomessa.</span><br>
          <span class="hero-line" data-delay="1.5">Puhdas koodi, rehellinen hinnoittelu, ei toimistoyläkustannuksia.</span>
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center hero-buttons" data-delay="2">
          <a
            href="/en/pricing"
            class="px-8 py-4 bg-primary-800 text-white rounded-md font-alexandria hover:bg-primary-700 transition-all duration-300 hover:shadow-lg hover:scale-105"
          >
            Katso hinnoittelu
          </a>
          <a
            href="/en/contact"
            class="px-8 py-4 bg-accent-100 text-primary-900 rounded-md font-alexandria hover:bg-accent-200 transition-all duration-300 hover:shadow-lg hover:scale-105"
          >
            Kysy lisää
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       2. PALVELUT (Services)
  ═══════════════════════════════════════════════ -->
  <section id="palvelut" class="py-20 md:py-32 bg-accent-50 animate-on-scroll">
    <div class="container mx-auto px-6 md:px-12">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block px-3 py-1 bg-white text-primary-800 rounded-full text-sm font-alexandria mb-4">
            Palvelut
          </span>
          <h2 class="font-alexandria font-bold text-3xl md:text-4xl mb-4">
            Tutustu palveluihini
          </h2>
          <p class="text-lg text-primary-800">
            Verkkosuunnittelu, sisältö, paikallinen haku — ja päivittäinen markkinatieto.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Verkkosuunnittelu -->
          <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
            <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-4">Verkkosuunnittelu</h3>
            <p class="text-primary-700 mb-6">
              Räätälöidyt verkkosivut rakennettu selkeydelle — helppoja vierailijoillesi navigoida, helppoja sinulle hallita, ja rakennettu niin että hakukoneet ja tekoälytyökalut voivat lukea ne tarkasti.
            </p>
            <a href="/en/services/web-design" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
              Lue lisää →
            </a>
          </div>

          <!-- Digitaalinen sisältö -->
          <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
            <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-4">Digitaalinen sisältö</h3>
            <p class="text-primary-700 mb-6">
              Lyhyet videosisällöt, sosiaalisen median kuvat, markkinointimateriaalit ja sähköpostikampanjat, jotka kertovat tarinasi ilman hälyä. Tehty vastaamaan sivustosi ääntä.
            </p>
            <a href="/en/services/content-creation" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
              Lue lisää →
            </a>
          </div>

          <!-- Google My Business -->
          <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
            <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-4">Google My Business</h3>
            <p class="text-primary-700 mb-6">
              Google-profiilisi asetettu ja optimoitu niin, että paikalliset haut löytävät sinut ensin. Erityisen hyödyllinen, jos asiakkaasi ovat lähellä ja etsivät juuri nyt.
            </p>
            <a href="/en/services/google-my-business" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
              Lue lisää →
            </a>
          </div>

          <!-- Markkinatieto -->
          <div class="bg-white p-8 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:scale-105 transition-all duration-300">
            <div class="w-12 h-12 mb-6 flex items-center justify-center bg-primary-100 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-4">Markkinatieto</h3>
            <p class="text-primary-700 mb-6">
              Päivittäinen skannaus kilpailijoistasi, ostajien hauista ja näkyvyysaukoistasi — toimitettuna rakenteellisena aamuraportina. Jokainen väite lähdeverifioitu.
            </p>
            <a href="/en/contact" class="text-primary-600 hover:text-primary-800 font-alexandria font-medium">
              Lue lisää →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       3. MARKKINATIETO – oma osio (Market Intelligence)
  ═══════════════════════════════════════════════ -->
  <section id="markkinatieto" class="py-20 md:py-32 animate-on-scroll">
    <div class="container mx-auto px-6 md:px-12">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block px-3 py-1 bg-accent-100 text-primary-800 rounded-full text-sm font-alexandria mb-4">
            Päivittäinen tieto
          </span>
          <h2 class="font-alexandria font-bold text-3xl md:text-4xl mb-4">
            Joka aamu. Jokainen liike.
          </h2>
          <p class="text-lg text-primary-800">
            Tiedä mitä markkinoillasi tapahtuu.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          <div class="bg-accent-50 p-8 rounded-xl bloom-card hover:shadow-lg transition-all duration-300">
            <div class="w-12 h-12 mb-6 flex items-center justify-center bg-white rounded-full shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-4">Mitä seurataan</h3>
            <p class="text-primary-700">
              Kilpailijoiden toiminta, live-ostajahaut ja hakukoneen näkyvyytesi — tarkistetaan päivittäin sinun erityismarkkinaasi vasten, ei yleistä toimialapohjaa.
            </p>
          </div>

          <div class="bg-accent-50 p-8 rounded-xl bloom-card hover:shadow-lg transition-all duration-300">
            <div class="w-12 h-12 mb-6 flex items-center justify-center bg-white rounded-full shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 9v.906a2.25 2.25 0 01-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 001.183 1.981l6.478 3.488m8.839 2.51l-4.66-2.51m0 0l-1.023-.55a2.25 2.25 0 00-2.134 0l-1.022.55m0 0l-4.661 2.51m16.5 1.615a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V8.844a2.25 2.25 0 011.183-1.98l7.5-4.04a2.25 2.25 0 012.134 0l7.5 4.04a2.25 2.25 0 011.183 1.98V19.5z" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-4">Mitä saapuu postilaatikkoosi</h3>
            <p class="text-primary-700">
              Lyhyt, rakenteellinen raportti. Lähdeverifioidut väitteet, vain sen päivän data. Kirjoitettu niin, että voit lukea sen aamukahvin kanssa ja tietää tarkalleen missä seisot.
            </p>
          </div>

          <div class="bg-accent-50 p-8 rounded-xl bloom-card hover:shadow-lg transition-all duration-300">
            <div class="w-12 h-12 mb-6 flex items-center justify-center bg-white rounded-full shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-4">Mitä teet seuraavaksi</h3>
            <p class="text-primary-700">
              Priorisoitu toimintolista jokaisen raportin lopussa. Kiireelliset kohteet merkitty. Strategiset huomioitu. Ei kojelautaan kirjautumista.
            </p>
          </div>
        </div>

        <div class="text-center">
          <p class="text-primary-800 mb-6 max-w-2xl mx-auto">
            Soveltuu brändeille, jotka kilpailevat määritellyssä hakukategoriassa tai vähittäiskanavassa — jossa poissaolo aiheuttaa suoran kustannuksen.
          </p>
          <a
            href="/en/contact"
            class="inline-block px-8 py-4 bg-primary-800 text-white rounded-md font-alexandria hover:bg-primary-700 transition-all duration-300 hover:shadow-lg hover:scale-105"
          >
            Ota yhteyttä →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       4. ASIAKKAAT (Who I Work With)
  ═══════════════════════════════════════════════ -->
  <section id="asiakkaat" class="py-20 md:py-32 bg-accent-50 animate-on-scroll">
    <div class="container mx-auto px-6 md:px-12">
      <div class="max-w-3xl mx-auto">
        <span class="inline-block px-3 py-1 bg-white text-primary-800 rounded-full text-sm font-alexandria mb-4">
          Asiakkaat
        </span>
        <h2 class="font-alexandria font-bold text-3xl md:text-4xl mb-8">
          Kenen kanssa teen töitä
        </h2>
        <p class="text-lg text-primary-800 mb-10">
          Pienyritykset ja luovat ammattilaiset Jyväskylässä ja ympäri Suomea.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          <div class="bg-white p-6 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 mb-4 flex items-center justify-center bg-primary-100 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />
              </svg>
            </div>
            <h3 class="font-alexandria font-bold text-xl mb-3">Itsenäiset kahvilat ja leipomot</h3>
            <p class="text-primary-700">
              Paikalliset kahvilat ja leipomot, jotka tarvitsevat yksinkertaisen mutta tehokkaan verkkoläsnäolon esitelläkseen tarjontaansa ja yhdistääkseen asiakkaisiinsa.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl shadow-sm bloom-card hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 mb-4 flex items-center justify-center bg-primary-100 rounded-full">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.38a48.474 48.474 0 00-6-.37c-2.032 0-4.034.125-6 .37m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.17c0 .62-.504 1.124-1.125 1.124H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12.265 3.11a.375.375 0 11-.53 0L12 2.845l.265.265zm-3 0a.375.375 0 11-.53 0L9 2.845l.265.265zm6 0a.375.375 0 11-.53 0L15 2.845l.265.265z" />
              </svg>
            </div>
