<style>
  /* Hero animations */
  .hero-line {
    opacity: 0;
    transform: translateY(30px);
    display: inline-block;
  }
  .hero-buttons {
    opacity: 0;
    transform: translateY(30px);
  }

  /* Logo characters */
  @keyframes logoRun {
    0%   { transform: translate(0, 0) scale(1); }
    25%  { transform: translate(-50px, -30px) scale(1.1); }
    50%  { transform: translate(-100px, 20px) scale(0.9); }
    75%  { transform: translate(-30px, 40px) scale(1.05); }
    100% { transform: translate(0, 0) scale(1); }
  }
  #logo-char-1 { animation: logoRun 8s ease-in-out infinite; }
  #logo-char-2 { animation: logoRun 12s ease-in-out infinite; animation-delay: 4s; }

  /* Banner animations */
  .pastry-image {
    opacity: 0;
    animation: fadeIn 1s ease-out forwards;
  }
  @keyframes fadeIn { to { opacity: 1; } }

  .lakeside-image { animation: subtleRipple 6s ease-in-out infinite; }
  @keyframes subtleRipple {
    0%, 100% { transform: scale(1); }
    50%       { transform: scale(1.02); }
  }

  /* Process parallax */
  .parallax-bg { transform: translateZ(0); will-change: transform; }
  @media (prefers-reduced-motion: no-preference) {
    .parallax-bg { animation: parallaxMove 20s ease-in-out infinite; }
  }
  @keyframes parallaxMove {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }

  /* Footer lake */
  .lake-forest { animation: subtleWave 8s ease-in-out infinite; }
  @keyframes subtleWave {
    0%, 100% { transform: translateY(0px) scale(1); }
    50%       { transform: translateY(-5px) scale(1.01); }
  }

  /* Contact button glow */
  .contact-button {
    box-shadow: 0 0 0 0 rgba(55, 65, 81, 0.5);
    animation: buttonGlow 2s infinite;
  }
  @keyframes buttonGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(55, 65, 81, 0.5); }
    50%       { box-shadow: 0 0 0 10px rgba(55, 65, 81, 0); }
  }

  /* FAQ */
  details summary::-webkit-details-marker { display: none; }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Hero text line-by-line
  document.addEventListener('DOMContentLoaded', () => {
    const heroLines = document.querySelectorAll('.hero-line');
    const heroButtons = document.querySelector('.hero-buttons');

    heroLines.forEach((line) => {
      const delay = parseFloat(line.dataset.delay) || 0;
      gsap.to(line, { opacity: 1, y: 0, duration: 0.8, delay, ease: "power2.out" });
    });

    if (heroButtons) {
      const delay = parseFloat(heroButtons.dataset.delay) || 0;
      gsap.to(heroButtons, { opacity: 1, y: 0, duration: 0.8, delay, ease: "power2.out" });
    }
  });

  // Bloom cards
  gsap.utils.toArray('.bloom-card').forEach((card) => {
    gsap.fromTo(
      card,
      { opacity: 0, scale: 0.8, filter: "blur(5px)" },
      {
        opacity: 1, scale: 1, filter: "blur(0px)", duration: 0.8, ease: "power2.out",
        scrollTrigger: { trigger: card, start: "top 80%", toggleActions: "play none none none" }
      }
    );
  });

  // Fade-in sections
  gsap.utils.toArray('.animate-on-scroll').forEach((section) => {
    gsap.fromTo(
      section,
      { opacity: 0, y: 50 },
      {
        opacity: 1, y: 0, duration: 0.8, ease: "power2.out",
        scrollTrigger: { trigger: section, start: "top 80%", toggleActions: "play none none none" }
      }
    );
  });
</script>
